    - name: container_right
      type: containerCOMP
      parameters:
        w: 270
        h: 26
        leftanchor: 1
        horigin: 1
        align: horizrl
      flags:
      - viewer
      position: [175, 0]
      size: [160, 76]
      children:
      - name: pars
        type: textCOMP
        parameters:
          text: Pars
          font: Open Sans
          fontsize: 9
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
          w: 51
          vmode: fill
          alignorder: 350
          clickthrough: true
          bgcolorr: =parent.Embody.par.Buttonbackgroundcolorr.eval() + (0.06 if me.fetch('hover', False) else 0)
          bgcolorg: =parent.Embody.par.Buttonbackgroundcolorg.eval() + (0.06 if me.fetch('hover', False) else 0)
          bgcolorb: =parent.Embody.par.Buttonbackgroundcolorb.eval() + (0.06 if me.fetch('hover', False) else 0)
          bgalpha: 1
        position: [600, 0]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
      - name: close
        type: textCOMP
        parameters:
          text: "\U000F05AD"
          font: Material Design Icons
          fontsize: 11
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
          w: 26
          vmode: fill
          alignorder: -200
          clickthrough: true
          bgcolorr: =parent.Embody.par.Buttonbackgroundcolorr.eval() + (0.06 if me.fetch('hover', False) else 0)
          bgcolorg: =parent.Embody.par.Buttonbackgroundcolorg.eval() + (0.06 if me.fetch('hover', False) else 0)
          bgcolorb: =parent.Embody.par.Buttonbackgroundcolorb.eval() + (0.06 if me.fetch('hover', False) else 0)
          bgalpha: 1
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
      - name: filter
        type: textCOMP
        parameters:
          text: ''
          editmode: editablecontinuous
          placeholdertext: Filter...
          font: Open Sans
          fontsize: 9
          fontsizeunits: points
          fontcolorr: =parent.Embody.par.Textcolorr
          fontcolorg: =parent.Embody.par.Textcolorg
          fontcolorb: =parent.Embody.par.Textcolorb
          textoffsetx: 8
          alignx: left
          w: 170
          vmode: fill
          alignorder: 25
          bgcolorr: 0.08
          bgcolorg: 0.08
          bgcolorb: 0.08
          bgalpha: 1
        position: [200, 0]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
      - name: spacer_pars
        type: containerCOMP
        parameters:
          w: 10
          vmode: fill
          alignorder: 100
          clickthrough: true
        position: [400, 0]
        size: [160, 130]
