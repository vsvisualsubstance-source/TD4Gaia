  - name: timer1
    type: timerCHOP
    parameters:
      active: never
      deferpars: true
      length: 30
      lengthunits: frames
      delayunits: samples
      maxcycles: 2
      callbacks: timer_callbacks
      outfraction: false
      outready: false
      outdone: false
      exttcop: =tdu.Timecode()
      rate: =me.time.rate
      autoexportroot: =parent()
    position: [-700, -275]
    size: [130, 90]
  - name: wizard
    type: containerCOMP
    parameters:
      w: 500
      h: 520
      bgcolorr: 0.11
      bgcolorg: 0.12
      bgcolorb: 0.115
      bgalpha: 1
      align: verttb
      spacing: 10
    position: [1200, 225]
    size: [160, 130]
    storage:
      ext_needed: true
      finish_pending: true
      git_missing: true
      needs_save: false
      sel:
        mode: advanced
      sel_assistant: claudecode
      sel_client: ''
      sel_convoy: disable
      sel_externalize: full
      sel_git: gitinit
      sel_mode: auto
      sel_permissions: all
      sel_root: gitroot
      step: 0
      step_id: summary
    children:
    - name: hint
      type: textCOMP
      parameters:
        type: multiline
        wordwrap: true
        callbacks: hint_callbacks
        fontsize: 11
        fontcolorr: 0.6
        fontcolorg: 0.61
        fontcolorb: 0.6
        textoffsetx: 24
        textpaddingr: 20
        alignx: left
        aligny: top
        w: 452
        alignorder: 3
        clickthrough: true
        bgcolorr: 0.11
        bgcolorg: 0.12
        bgcolorb: 0.115
        bgalpha: 1
      size: [160, 130]
      color: [0.325, 0.8, 0.3]
      tags:
      - tox
    - name: logic
      type: textDAT
      parameters:
        file: Embody/wizard/logic.py
        syncfile: true
        language: python
      position: [0, 200]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: title
      type: textCOMP
      parameters:
        wordwrap: true
        callbacks: title_callbacks
        fontsize: 18
        fontcolorr: 0.92
