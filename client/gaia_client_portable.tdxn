          bgcolorg: =parent.Embody.par.Backgroundcolorg
          bgcolorb: =parent.Embody.par.Backgroundcolorb
          bgalpha: =parent.Embody.par.Backgroundcolora
          topsmoothness: mipmap
          reloadbuiltin: false
          relpath: inherit
        position: [50, 0]
        size: [160, 134]
        children:
        - name: out1
          type: outCHOP
          parameters:
            label: =me.name
          flags:
          - viewer
          position: [275, 175]
          inputs:
          - par1
        - name: par1
          type: parameterCHOP
          position: [65, 175]
        - name: text
          type: textCOMP
          parameters:
            text: =parent().par.label
            type: multiline
            legacyfontselection: true
            scaletofit: onlyshrink
            fontsize: 12
            fontcolorr: =[c/.5 for c in [.1, .3]][parent().panel.state] * parent().par.colorr + .5
            fontcolorg: =[c/.5 for c in [.1, .3]][parent().panel.state] * parent().par.colorg + .5
            fontcolorb: =[c/.5 for c in [.1, .3]][parent().panel.state] * parent().par.colorb + .5
            textpaddingl: 3
            textpaddingr: 3
            textpaddingb: 3
            textpaddingt: 3
            hmode: fill
            vmode: fill
            clickthrough: true
            bgcolorr: =parent.Embody.par.Listheadercolorr
            bgcolorg: =parent.Embody.par.Listheadercolorg
            bgcolorb: =parent.Embody.par.Listheadercolorb
            bgalpha: 1
            borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorr + .2
            borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorg + .2
            borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorb + .2
            borderaalpha: 0
            reloadbuiltin: false
          flags:
          - viewer
          position: [74, 26]
          size: [113, 108]
        - name: parexec1
          type: parameterexecuteDAT
          parameters:
            op: ..
            pars: value0
            onpulse: false
            defaultreadencoding: cp1252
          flags:
          - viewer
          position: [66, -83]
          size: [128, 66]
          dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select :\n\t\tparent().panel.state = par.eval()\n\t\t\n\tif par:\n\t\tparent.Embody.ext.Embody.tagExiter()\n\t\t\n\treturn"
          dat_content_format: text
        - name: panelexec1
          type: panelexecuteDAT
          parameters:
            panels: =parent()
            panelvalue: state
            offtoon: false
            valuechange: true
            defaultreadencoding: cp1252
          flags:
          - viewer
          position: [247, -81]
          size: [126, 62]
          dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\t\t\n\treturn"
          dat_content_format: text
