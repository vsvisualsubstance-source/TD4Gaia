format: tdxn
version: '2.1'
generator: Embody/6.2.65
td_build: 099.2025.33230
source_file: gaia_client_portable.10.toe
exported_at: '2026-09-30T13:55:38Z'
network_path: /
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  baseCOMP:
    size: [160, 130]
    tags:
    - tox
  buttonCOMP:
    parameters:
      clone: =op.TDTox.op('defaultCOMPs/button')
      repocomp: =me
      resizecomp: =me
  choptoTOP:
    parameters:
      format: rgba32float
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantCHOP:
    parameters:
      autoexportroot: =parent()
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  containerCOMP:
    parameters:
      repocomp: =me
      resizecomp: =me
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  executeDAT:
    parameters:
      fromop: =parent()
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
    tags:
    - py
  inCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  inDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  listCOMP:
    parameters:
      hscrollbar: false
      repocomp: =me
      resizecomp: =me
    size: [160, 130]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
  mergeCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mqttclientDAT:
    parameters:
      fromop: =parent()
      netaddress: ="tcp://" + parent.GaiaClient.par.Brokerhost.eval() + ":" + str(int(parent.GaiaClient.par.Brokerport.eval()))
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
  outCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
  outDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  panelexecuteDAT:
    parameters:
      fromop: =parent()
  parameterCHOP:
    parameters:
      autoexportroot: =parent()
      builtin: true
      custom: false
      parameters: value0
      renameto: v1
    flags:
    - viewer
    size: [130, 90]
  parameterexecuteDAT:
    parameters:
      fromop: =parent()
  scriptCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  scriptDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  selectCHOP:
    parameters:
      autoexportroot: =parent()
    size: [130, 90]
  selectDAT:
    parameters:
      colexpr: =re.match('.*',me.inputCell.val) != None
      colindexend: =me.inputTable.numCols - 1
      rowexpr: =re.match('.*',me.inputCell.val) != None
      rowindexend: =me.inputTable.numRows - 1
    flags:
    - viewer
    size: [130, 90]
  tableDAT:
    parameters:
      syncfile: true
    size: [130, 90]
    color: [0.9, 0.3, 0.4]
  textCOMP:
    parameters:
      repocomp: =me
      resizecomp: =me
  textTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  windowCOMP:
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
type: baseCOMP
flags:
- display
- render
color: [0.67, 0.67, 0.67]
tags:
- tdxn
operators:
- name: Embody
  type: containerCOMP
  parameters:
    w: ~op('./manager').par.w
    h: ~op('./manager').par.h
    display: false
    borderover: false
    align: horizlr
    justifyv: top
    parentshortcut: Embody
    opshortcut: Embody
    nodeview: opviewer
    opviewer: ./viz_status
    reloadbuiltin: false
  sequences:
    ext:
    - object: op('./EmbodyExt').module.EmbodyExt(me)
      name: Embody
      promote: true
    - object: op('./EnvoyExt').module.EnvoyExt(me)
      name: Envoy
      promote: true
    - object: op('./TDXNExt').module.TDXNExt(me)
      name: TDXN
      promote: true
    - object: op('./CatalogManagerExt').module.CatalogManagerExt(me)
      name: CatalogManager
      promote: true
    - {}
    - {}
    - {}
    - {}
    - {}
    - {}
    - {}
  custom_pars:
    Embody:
    - name: Setupwizard
      style: Pulse
      label: Setup Wizard
      help: Open the Embody setup wizard to review or change your mode, AI assistant, and where config files are written.
    - name: Embodymode
      style: Menu
      label: Mode
      default: auto
      menuNames:
      - auto
      - advanced
      menuLabels:
      - Auto - manage everything
      - Advanced - ask first
      help: How Embody handles invasive, project-level changes (git config, .venv, MCP/AI config files, network ops). 'Auto' manages everything silently -- recommended for most users. 'Advanced' asks before each such change and keeps the footprint minimal -- for users who want full control.
    - name: Folder
      style: Folder
      label: Ext. Folder (Rel. to Project)
      startSection: true
      help: Root folder where externalized files are saved. All .tox, .py, .json, and other externalized files are written relative to this folder.
    - name: Externalizeproject
      style: Pulse
      label: Externalize Full Project
      startSection: true
      help: Tags all eligible operators in the entire project for externalization. COMPs get .tox tags, DATs get file-type tags based on their content.
    - name: Disable
      style: Pulse
      startSection: true
      help: 'Disables Embody: removes all externalization tags from operators and stops tracking. Use Update to re-enable.'
    - name: Update
      style: Pulse
      label: Enable / Update
      help: 'Initializes Embody if not yet running, or triggers a full update cycle: scans all tagged operators, checks continuity, and syncs the externalizations table.'
    - name: Releaseall
      style: Pulse
      label: Export All Release Toxes
      help: Export every releasable component as its own portable .tox into the release folder, in one pass. A component is releasable when it is BOTH externalized by Embody (tracked -- it is yours) AND carries a release hook (a pre_release or post_release Text DAT as a direct child). Third-party components that ship with their authors' hook DATs are never batch-released -- export those explicitly if needed. Failures are logged and skipped without halting the batch.
    - name: Exportreleasetoe
      style: Pulse
      label: Export Release Toe
      help: 'Export the WHOLE project as a locked, self-contained release .toe: every externalized file inlined back into its operator, Embody removed, then saved and TouchDesigner quits. Pulsing PROMPTS FIRST -- what will be written, what this session loses, and whether the project is exportable at all -- before it ever asks for a location; you then pick the file and confirm once more against that exact path. Cancel at either prompt and nothing is touched (that is the dry run). One-way, no undo: run it in a dedicated TouchDesigner instance, never the one you are editing in. For a privacy-locked build call op.Embody.ExportReleaseToe(save_path, privacy_key=..., confirm=True) in Python.'
    - name: Refresh
      style: Pulse
      help: Refreshes the externalizations table by re-scanning tagged operators without triggering saves or continuity checks.
    - name: Performmode
      style: Toggle
      label: Perform Mode
      startSection: true
    - name: Status
      style: Str
      label: Embody Status
      startSection: true
      readOnly: true
      help: Current Embody status (read-only). Shows whether Embody is initialized and running.
      value: Disabled
    Tags:
    - name: Toxtags
      style: Header
      label: tox Tags
      help: Tag strings and operator colors for TOX externalization. COMPs tagged with the Tox tag are externalized as .tox files.
    - name: Toxtagcolor
      style: RGBA
      label: tox Tag Color
      size: 3
      help: Color applied to tox-tagged COMP operators in the network editor. Makes externalized COMPs visually identifiable.
      values: [0.325, 0.8, 0.3]
    - name: Toxtag
      style: Str
      label: .tox Tag
      help: Tag string applied to COMP operators for .tox externalization. Operators with this tag are externalized as .tox files.
      value: tox
    - name: Dattags
      style: Header
      label: DAT Tags
      startSection: true
      help: Tag strings and operator colors for DAT externalization. DATs are tagged with format-specific tags (py, json, xml, etc.) and externalized to matching file types.
    - name: Dattagcolor
      style: RGBA
      label: DAT Tag Color
      size: 3
      help: Color applied to DAT-tagged operators in the network editor. Makes externalized DATs visually identifiable.
      values: [0.9, 0.3, 0.4]
    - name: Clonetagcolor
      style: RGBA
      label: Clone Tag Color
      size: 3
      help: Color applied to clone-tagged operators in the network editor. Distinguishes cloned externalized operators from originals.
      values: [1, 0.7, 0.1]
    - name: Pytag
      style: Str
      label: .py Tag
      help: Tag string for .py (Python) externalization. Applied to text DATs containing Python code.
      value: py
    - name: Jsontag
      style: Str
      label: .json Tag
      startSection: true
      help: Tag string for .json externalization. Applied to text DATs containing JSON data.
      value: json
    - name: Xmltag
      style: Str
      label: .xml Tag
      help: Tag string for .xml externalization. Applied to text DATs containing XML data.
      value: xml
    - name: Htmltag
      style: Str
      label: .html Tag
      help: Tag string for .html externalization. Applied to text DATs containing HTML content.
      value: html
    - name: Glsltag
      style: Str
      label: .glsl Tag
      startSection: true
      help: Tag string for .glsl externalization. Applied to text DATs containing GLSL shader code.
      value: glsl
    - name: Fragtag
      style: Str
      label: .frag Tag
      help: Tag string for .frag externalization. Applied to text DATs containing fragment shader code.
      value: frag
    - name: Verttag
      style: Str
      label: .vert Tag
      help: Tag string for .vert externalization. Applied to text DATs containing vertex shader code.
      value: vert
    - name: Txttag
      style: Str
      label: .txt Tag
      startSection: true
      help: Tag string for .txt externalization. Applied to text DATs containing plain text.
      value: txt
    - name: Mdtag
      style: Str
      label: .md Tag
      help: Tag string for .md externalization. Applied to text DATs containing Markdown content.
      value: md
    - name: Rtftag
      style: Str
      label: .rtf Tag
      help: Tag string for .rtf externalization. Applied to text DATs containing rich text format content.
      value: rtf
    - name: Csvtag
      style: Str
      label: .csv Tag
      startSection: true
      help: Tag string for .csv externalization. Applied to table DATs with comma-separated values.
      value: csv
    - name: Tsvtag
      style: Str
      label: .tsv Tag
      help: Tag string for .tsv externalization. Applied to table DATs with tab-separated values.
      value: tsv
    - name: Dattag
      style: Str
      label: .dat Tag
      help: Tag string for .dat externalization. Generic DAT externalization format.
      value: dat
    - name: Tdxntags
      style: Header
      label: TDXN Tags
      startSection: true
      help: Tag strings and operator colors for TDXN externalization. COMPs tagged with the TDXN tag have their children exported as human-readable .tdxn YAML network files.
    - name: Tdxntagcolor
      style: RGBA
      label: TDXN Tag Color
      default: [0.3, 0.5, 0.9, 1]
      help: Color applied to TDXN-tagged COMP operators in the network editor. Makes TDXN-strategy COMPs visually identifiable.
    - name: Tdxntag
      style: Str
      label: TDXN Tag
      default: tdxn
      help: Tag string applied to COMPs externalized with the TDXN strategy (their children are exported as human-readable YAML network files). Default 'tdxn' (it was 'tdn' before 6.2.30). Both spellings are ACCEPTED on read forever, so an existing project keeps working; the tagger's Actions menu re-tags one in a single gesture.
    - name: Tdxnexcludetag
      style: Str
      label: TDXN Exclude Tag
      startSection: true
      default: tdxn_exclude
      help: 'Tag family for excluding things from the TDXN system (default ''tdxn_exclude''; the legacy ''tdn_exclude'' is still read). BARE tag on a COMP: the COMP is invisible to TDXN -- never exported, never inlined in parent .tdxn files, never stripped on save, never destroyed by reconstruction. Primary use: opt a single child out of cascade autotag, or app-managed COMPs (e.g. spawned via .copy() at runtime). SUFFIXED ''tdxn_exclude:<parname>'' on ANY operator: that parameter''s constant value is omitted from TDXN export while the operator, its other parameters, and its wiring export normally -- for runtime state a project must not commit (a negotiated port, a session file path). Expressions/binds still export; unknown parameter names log a WARNING. Manage both visually via the tagger''s Exclude from tdxn panel. Clear this parameter to disable the whole family.'
    TDXN:
    - name: Tdxnmode
      style: Menu
      label: TDXN Mode
      startSection: true
      default: export
      menuNames:
      - 'off'
      - export
      - full
      menuLabels:
      - 'Off'
      - Export-on-Save
      - Roundtrip (Experimental)
      help: Three-mode master for the TDXN subsystem. Off = no TDXN runtime (.tdxn files on disk are preserved, Embody simply stops touching them). Export-on-Save (recommended) = write .tdxn on save, .toe stays the source of truth, MCP reads live state via read_tdn. Roundtrip (Experimental) = bidirectional strip/restore of COMPs at save and open; may hit edge cases with extension reload timing on deeply-nested TDXN COMPs.
    - name: Autosavestatus
      style: Str
      label: Auto-Save Status
      readOnly: true
      help: 'Read-only auto-save state: Idle / Saving / Bypassed (Perform Mode) / Disabled.'
      value: Idle
    - name: Embeddatsintdxns
      style: Toggle
      label: Embed DATs (default)
      startSection: true
      help: Also copy file-backed DAT content into TDXN exports; unexternalized, editable DAT content is always included.
    - name: Embedstorageintdxns
      style: Toggle
      label: Embed Storage (default)
      default: true
      help: Include Python storage entries in TDXN exports. Disable for COMPs with large storage to reduce file size. Can be overridden per-COMP from the tagging menu.
    - name: Tdxncascade
      style: Toggle
      label: Cascade to Children
      startSection: true
      help: When tagging a COMP for TDXN, automatically tag all child COMPs so each gets its own .tdxn file. Children already tagged TOX or tdxn_exclude (and everything below them) are skipped.
    - name: Tdxncascadewarn
      style: Menu
      label: Large TDXN Warning
      default: ask
      menuNames:
      - ask
      - quiet
      menuLabels:
      - Ask
      - Quiet
      help: Controls whether a warning dialog is shown when a TDXN file exceeds 5 MB. Set automatically when dismissed.
    - name: Tdxnlockedwarn
      style: Menu
      label: Locked Content Warning
      default: ask
      menuNames:
      - ask
      - quiet
      menuLabels:
      - Ask
      - Quiet
      help: Controls whether a dialog is shown when a TDXN export contains locked TOPs, CHOPs, SOPs, or POPs, whose frozen data a .tdxn cannot store. The dialog labels each operator's source and offers Switch to TOX when a child COMP can hold them. Batch sweeps show one combined dialog. The WARNING is logged either way; externalize_op, save_externalization, export_network and the Autoexternalize step of create_op, copy_op and create_extension only log it. Set automatically when dismissed with Don't show again.
    - name: Autosave
      style: Toggle
      label: Auto-Save Checkpoints
      startSection: true
      default: true
      help: When on, after the agent (or you) goes idle Embody writes changed TDXN COMPs to disk as a cheap ~6ms .tdxn checkpoint -- NO full project save, no strip/restore, no freeze -- so a crash loses little unsaved work. Checkpointed COMPs are rebuilt on next open. Skips during Perform Mode and project saves.
    - name: Tdxncreateonstart
      style: Toggle
      label: TDXN Create on Start
      startSection: true
      default: true
      help: When enabled, reconstructs TDXN-strategy COMP children from .tdxn files on disk when the project opens. Required for TDXN round-trip workflow where children are stripped on save.
      enable: false
    - name: Tdxnstriponsave
      style: Toggle
      label: Strip on Save
      default: true
      help: When enabled, strips children from TDXN-strategy COMPs during project save. Children are recreated on next open via TDXN Create on Start. Keeps .toe files minimal.
      enable: false
    - name: Tdxnpalettehandling
      style: Menu
      label: Palette Handling
      startSection: true
      default: ask
      menuNames:
      - ask
      - blackbox
      - fullexport
      menuLabels:
      - Ask
      - Black Box
      - Full Export
      help: 'How to handle TD palette COMPs (e.g. abletonLink, Widget components) during TDXN export. Ask: prompt on first encounter per COMP. Black Box: reference the palette and skip internal children -- the correct choice for stock palette components. Full Export: export all internals -- use when the palette COMP has been heavily customized internally.'
      value: blackbox
    - name: Tdxnfile
      style: File
      label: TDXN File
      startSection: true
      help: Path to a .tdxn file to import. Select a file, set the Network Path target, then pulse Import TDXN.
    - name: Networkpath
      style: COMP
      label: Network Path
      help: Target COMP where the TDXN file will be imported. Operators from the .tdxn are created as children of this COMP.
    - name: Importtdxn
      style: Pulse
      label: Import TDXN
      help: Imports the specified TDXN File into the Network Path target. Creates all operators, sets parameters, connections, and positions.
    - name: Clipboardautopaste
      style: Toggle
      label: Clipboard Auto-Paste
      startSection: true
      default: true
      help: When on, Embody watches the OS clipboard and prompts to paste an Embody network the moment one is copied (e.g. the web "embody it" button) -- no keyboard shortcut needed. Turn off to disable the automatic prompt.
    - name: Migratetotdxn
      style: Pulse
      label: Migrate .tdn to .tdxn
      startSection: true
      help: 'One-time, opt-in conversion of the network files you already have. Renames every tracked .tdn to .tdxn, repoints the externalizations table, and updates the tdn_ref pointers inside parent files so nested COMPs keep resolving. Contents are unchanged. New externalizations already use .tdxn -- this only affects existing files. Commit or stash first if the project is under version control; Embody performs the renames itself, so never git mv them. Safe to re-run: it converges.'
    Envoy:
    - name: Envoyenable
      style: Toggle
      label: Enable Envoy
      startSection: true
      help: Enables/disables the Envoy MCP server. When enabled, starts an HTTP server that exposes TouchDesigner operations to Claude Code and other MCP clients.
      value: true
    - name: Envoystatus
      style: Str
      label: Envoy Status
      readOnly: true
      help: Current status of the Envoy MCP server (read-only). Shows Running, Stopped, or error information.
      value: Disabled
    - name: Configclient
      style: Menu
      label: Configure For
      startSection: true
      default: claudecode
      menuNames:
      - claudecode
      - opencode
      - codex
      - gemini
      - vscode
      - cursor
      - windsurf
      - copilot
      - antigravity
      - none
      menuLabels:
      - Claude Code
      - OpenCode
      - Codex
      - Gemini
      - VS Code
      - Cursor
      - Windsurf
      - GitHub Copilot (VS Code)
      - Antigravity IDE
      - None
      help: 'Which AI client Embody generates config files for: its instruction files (rules, skills) and the MCP config THAT client reads -- the root .mcp.json is Claude Code''s format and no other client reads it. AGENTS.md and .mcp.json are written for every project regardless. Generation is additive and never removes, so selecting a second client later leaves the first one configured and still tracking bridge and port changes -- pick each in turn to serve several clients from one project. Set to None to generate no client config at all (Convoy-only projects).'
    - name: Aiclient
      style: Menu
      label: Launch Client
      default: '0'
      menuNames:
      - claudecode
      - opencode
      - codex
      - gemini
      - vscode
      - cursor
      - windsurf
      - copilot
      - antigravity
      - none
      menuLabels:
      - Claude Code
      - OpenCode
      - Codex
      - Gemini
      - VS Code
      - Cursor
      - Windsurf
      - GitHub Copilot (VS Code)
      - Antigravity IDE
      - None
      help: Which AI client the Launch button opens at the project root. Editors (VS Code, Cursor, Windsurf, Antigravity IDE) open the folder as a workspace; CLI tools (Claude Code, Codex, Gemini, OpenCode) open in a new terminal. GitHub Copilot runs inside VS Code, so it opens VS Code. This opens an app and writes nothing -- Configure For above decides which config files Embody generates.
      value: claudecode
    - name: Launchaiclient
      style: Pulse
      label: Launch AI Client
      help: Open the client selected in AI Client at the project root (the AI Project Root setting decides which folder that is).
    - name: Aiprojectroot
      style: Menu
      label: AI Project Root
      startSection: true
      default: gitroot
      menuNames:
      - gitroot
      - projectfolder
      - custom
      menuLabels:
      - Git repository root
      - Project folder (.toe directory)
      - Custom
      help: Where Embody writes AI config (AGENTS.md, CLAUDE.md, .claude/, .cursor/, .mcp.json, .embody/). "Git root" (default) writes at the top of the git repo. "Project folder" writes alongside the .toe -- use this when your TD project lives in a subdirectory of a larger repo and you open that subdirectory as your AI tool workspace.
      value: projectfolder
    - name: Aiprojectrootcustom
      style: Folder
      label: AI Project Root (Custom)
      help: Custom directory for AI/MCP config when "AI Project Root" is set to "Custom". Relative paths are resolved against the .toe directory (e.g. "../" places config one level above the .toe -- useful when multiple TouchDesigner projects share a parent folder in a monorepo). Absolute paths are used as-is. Changing this path migrates Embody state and AI config to the new location.
      enable: false
    - name: Autoexternalize
      style: Menu
      label: Auto-Externalize New Ops
      startSection: true
      default: neither
      menuNames:
      - neither
      - dats
      - comps
      - both
      menuLabels:
      - Neither
      - DATs
      - COMPs
      - DATs and COMPs
      help: 'Auto-tag operators that Envoy creates via create_op for externalization to version-control-friendly files. Neither = off. DATs = externalize created DATs (source files). COMPs = externalize created COMPs (TDXN). DATs and COMPs = both. Only ops at an externalization boundary are tagged -- never ops already inside an externalized COMP, palette clones, or Embody itself. Additive only: it never deletes files or removes tags.'
      value: both
    - name: Toolpermissions
      style: Menu
      label: Tool Permissions
      default: all
      menuNames:
      - all
      - some
      - prompt
      - leave
      menuLabels:
      - Don't prompt for any tool
      - Prompt for some tools (read-only auto-approved)
      - Prompt for all tools
      - Leave settings file alone
      help: Whether Embody pre-approves Envoy MCP tool calls in .claude/settings.local.json so Claude Code isn't prompted on every tool use. all = pre-approve all Envoy tools (no prompts). some = pre-approve read-only/query tools only; tools that create/edit/delete/execute still prompt. prompt = pre-approve nothing; every tool prompts. leave = never create or modify settings.local.json. Except for 'leave', Embody also whitelists the OS temp directory so captured TOP images can be read without a prompt. The setup wizard sets this; you can change it here anytime. When AI Client is OpenCode, the same posture seeds the 'permission' block of a freshly created opencode.json (existing files are merged, never overwritten).
    - name: Embotenable
      style: Toggle
      label: Embot
      startSection: true
      default: true
      help: Show the Embot builder mascot. He appears on each operator Envoy creates or edits and narrates what it does. He settles where the work is rather than chasing it -- when the agent is hopping between networks he stays put and keeps narrating from where he stands, and he moves once the work has actually settled somewhere new. With Envoy Follow off he only ever appears in the network you are already viewing (building him into one you cannot see costs real time for nothing). Off hides him entirely (no character, no camera movement).
    - name: Envoyfollow
      style: Toggle
      label: Envoy Follow
      default: true
      help: Camera follows the operator Envoy is working on, panning the network editor to it. Works with or without the Embot character shown. With Embot on, the camera settles with him rather than cutting to every network the work merely passes through; with Embot off it follows every hop as before.
    - name: Envoyport
      style: Int
      label: Envoy Port
      startSection: true
      default: 9870
      help: 'Port number for the Envoy MCP server (default: 9870). Changing while running automatically restarts the server on the new port.'
      value: 1980
    Convoy:
    - name: Convoyenable
      style: Toggle
      label: Enable Convoy
      help: Joins this Embody node to other Convoy-enabled nodes on the same trusted LAN and lets those nodes discover, inspect, and control it -- queries, test runs, project saves, and more -- through Envoy. Enabling this installs and starts Convoy's small background app, opens an authenticated LAN listener, and begins automatic discovery and reconnect. Disable this on guest, public, or otherwise untrusted networks. Arbitrary TD Python and full shell stay OFF until you enable them locally on this machine. Convoy does not configure or launch an AI client, but it runs on Envoy (its Python environment and local command service), so enabling this turns Enable Envoy on if it is off. The first enable creates this project's convoy identity and asks for confirmation.
    - name: Convoystatus
      style: Str
      label: Status
      default: Disabled
      readOnly: true
      help: Convoy's current state -- whether this node is connected, and anything blocking or degrading it (needs Envoy, no host app, install failed, consent required, a realm conflict, a LAN listener on a tunnel or public network, a changed host identity, or peers rejecting this host's certificate).
      value: Disabled
    - name: Convoynodename
      style: Str
      label: Node Name
      startSection: true
      help: Display name for this node in Convoy. Defaults to '<hostname> / <toe filename>'. Editing it sets a persistent override; routing always uses the stable node identity, never this name.
    - name: Convoyremotewake
      style: Toggle
      label: Remote Wake
      startSection: true
      default: true
      help: Allows a real remote TouchDesigner operation to temporarily wake Convoy's command service while this node is in Perform Mode. Discovery, status, ping, and controller queries never wake it. After remote work finishes, the node returns to its previous Perform state following the idle grace period.
    - name: Convoywakegrace
      style: Float
      label: Remote Wake Idle Grace
      default: 60
      max: 3600.0
      clampMin: true
      normMax: 300.0
      help: Seconds after the final remote wake finishes before Convoy restores this node's previous Perform Mode state.
    - name: Convoyallowtdpython
      style: Toggle
      label: Allow Execute TD Python
      startSection: true
      help: Allows Convoy controllers to execute arbitrary Python inside this TouchDesigner process. Python can access the filesystem, network, credentials available to TouchDesigner, and operating-system process APIs, so enabling this is effectively host-user code execution even when Allow Full Shell is off. Keep it off unless explicitly needed. This setting can only be enabled locally.
    - name: Convoyallowfullshell
      style: Toggle
      label: Allow Full Shell
      help: Allows Convoy controllers to use Convoy's purpose-built interface for arbitrary operating-system commands as the current user. This can change or delete files, install software, or expose secrets. Structured Git and GitHub CLI tools do not require this option. Turning it off does not sandbox arbitrary TouchDesigner Python if Allow Execute TD Python is on. This setting applies to every Convoy node on this computer and can only be enabled locally.
    - name: Convoyartifactquota
      style: Int
      label: Artifact Quota (MB)
      startSection: true
      default: 1024
      max: 65536.0
      clampMin: true
      normMax: 8192.0
      help: 'Maximum disk space (MB) this computer may use for temporary Convoy artifacts: screenshots, transferred files, large tool results, command output, and local client-readable copies. When the limit is reached, Convoy removes the least-recently-used unpinned artifacts first. Active transfers, artifacts required by running or unacknowledged jobs, and files you explicitly saved are not removed. This setting applies to all Convoy-enabled Embody nodes on this computer.'
    - name: Convoynodes
      style: Sequence
      label: Convoy Nodes
      readOnly: true
    - name: Nodename
      style: Str
      label: Node Name
      readOnly: true
      help: Display name of the node.
      sequence: Convoynodes
    - name: Ipaddress
      style: Str
      label: IP Address
      readOnly: true
      help: Current LAN endpoint.
      sequence: Convoynodes
    - name: Nodestatus
      style: Str
      label: Status
      readOnly: true
      help: Node and connection status; notes an Embody version mismatch only when relevant.
      sequence: Convoynodes
    - name: Lastseen
      style: Str
      label: Last Seen
      readOnly: true
      help: How recently the node was seen.
      sequence: Convoynodes
    - name: Convoyforgetoffline
      style: Pulse
      label: Forget Offline Nodes...
      help: Remove this machine's offline Convoy node rows. Names the rows it would forget (the first eight, then a count) in a confirmation before anything is removed. A forgotten node rejoins as a NEW identity the next time its project opens, and its TD Python approval resets. A node with a delivery that has not finished is kept and named afterwards -- a finished result never holds a row, because results are fetched by delivery id and outlive it. A node that comes back online before you confirm is skipped. Each computer can only forget its own rows.
    - name: Convoyresolverealm
      style: Pulse
      label: Resolve Realm Conflict...
      startSection: true
      help: 'Recover from a split-realm conflict (status "Refused: local_realm_conflict"). Lists the conflicting Convoy realms and their live senders (hostname where reverse DNS answers), then offers both directions: Keep This Realm denylists those senders, resets this machine''s realm to the preserved one, and re-registers this node -- Join Other Realm abandons this machine''s realm, adopts the other one, and rebinds this project to it (other projects on this machine offer their rejoin on their next Convoy enable). Also usable without a conflict, to denylist -- or join -- foreign realms being advertised on the LAN.'
    - name: Convoyrepinpeers
      style: Pulse
      label: Re-pin Changed Peers...
      help: Trust the NEW identity of pinned peers that now announce a different one -- a peer whose host app lost its data directory or was reinstalled. Lists each changed peer (hostname where reverse DNS answers, address, old and new fingerprint) in a confirmation first. Re-pinning revokes any work the old key queued and lets this machine connect to the new identity; until then that peer's rows read pin mismatch and its own Status counts this machine among the peers rejecting it. Only re-pin a peer whose operator confirms the change -- an unexplained change is what an impersonator looks like.
    - name: Convoyinstallhost
      style: Pulse
      label: Repair Convoy App
      startSection: true
      help: Reinstall or upgrade the background app for YOUR user account. Enabling Convoy installs it automatically; use this to repair a broken install or apply an update.
    - name: Convoystarthost
      style: Pulse
      label: Start Convoy App
      help: Start the installed host app now, without waiting for the next login.
    - name: Convoystophost
      style: Pulse
      label: Stop Convoy App
      help: Stop the host app and keep it stopped. This disables the supervisor first -- otherwise it would restart within a minute and the button would look broken. Jobs already queued stay queued. Use Start Convoy App to resume.
    - name: Convoyuninstallhost
      style: Pulse
      label: Uninstall Convoy App
      help: Remove the host app and its login registration. Shows you exactly what will be removed and what will be KEPT before doing anything -- this machine's host identity and its job history are kept, so re-installing later rejoins the same convoy rather than becoming a new host.
    UI:
    - name: Openmanager
      style: Pulse
      label: Open Manager
      help: Opens the Embody Manager window, which provides a list view of all externalized operators with status, actions, and strategy management.
    - name: Closemanager
      style: Pulse
      label: Close Manager
      help: Closes the Embody Manager window.
    - name: Textcolor
      style: RGBA
      label: Text Color
      startSection: true
      help: Text color used throughout the Embody UI (toolbar, manager, dialogs).
      values: [0.59472, 0.63, 0.599424, 1]
    - name: Backgroundcolor
      style: RGBA
      label: Background Color
      help: Background color for the Embody UI panels and windows.
      values: [0.0968, 0.121, 0.121, 0.8]
    - name: Buttonbackgroundcolor
      style: RGBA
      label: Button Background Color
      help: Background color for buttons in the Embody UI.
      values: [0.1246, 0.14, 0.13, 1]
    - name: Listheadercolor
      style: RGBA
      label: List Header Color
      help: Header row color in the Manager list view.
      values: [0.089419, 0.121, 0.103104, 1]
    - name: Listrowcolor
      style: RGBA
      label: List Row Color
      help: Default row color in the Manager list view.
      values: [0.1246, 0.14, 0.13, 1]
    - name: Listrowselectcolor
      style: RGBA
      label: List Row Select Color
      help: Selected row highlight color in the Manager list view.
      values: [0.220088, 0.244, 0.221283, 1]
    - name: Savedcolor
      style: RGBA
      label: Saved Color
      help: Color indicator for operators that are saved and up-to-date (not dirty).
      values: [0.227574, 0.423, 0.289133, 0.5]
    - name: Dirtycolor
      style: RGBA
      label: Dirty Color
      help: Color indicator for operators that have unsaved changes (dirty state).
      values: [0.675, 0.25668, 0.2268, 1]
    - name: Dirtyparcolor
      style: RGBA
      label: Dirty Par Color
      help: Color indicator for parameters that have been modified since last save.
      values: [0.49, 0.321897, 0.16464, 1]
    - name: Uncommittedcolor
      style: RGBA
      label: Uncommitted Color
      default: [0.6, 0.3, 0.03, 1]
      help: Color indicator for externalized files that are saved to disk but not yet committed to git (uncommitted). Distinct from the red unsaved color and the amber par-change color.
    - name: Taggingmenucolor
      style: RGBA
      label: Tagging Menu Color
      help: Background color for the tagging menu popup.
      values: [0.2, 0.2, 0.2, 1]
    - name: Highlightcolor
      style: RGBA
      label: Highlight Color
      help: Accent/highlight color used for interactive elements in the Embody UI.
      values: [1, 1, 1, 1]
    - name: Tdxnsavedcolor
      style: RGBA
      label: TDXN Saved Color
      help: Color indicator for TDXN-strategy operators that are saved and up-to-date.
      values: [0.153552, 0.376081, 0.457, 1]
    Shortcuts:
    - name: Enablekeyboardshortcuts
      style: Toggle
      label: Enable Keyboard Shortcuts
      default: true
      help: Master switch for Embody's keyboard shortcuts. When off, the Keyboard In DAT is disabled and no Embody shortcut (including the tagger double-tap) fires.
      value: false
    - name: Shortcutmanager
      style: Str
      label: Open Manager
      startSection: true
      default: ctrl+shift+o
      help: 'Keyboard shortcut for Open Manager. Lowercase combo like ''cmd+shift+o'' or ''ctrl+shift+o'': modifiers joined with ''+'' plus one trigger key. ctrl and cmd are distinct keys on macOS (matched exactly); on Windows/Linux, which has no Cmd key, a cmd binding fires via Ctrl. Each combo may be assigned to only one action. Leave empty to disable. Edit by hand or pulse Record below.'
      value: cmd+shift+o
    - name: Recordmanager
      style: Pulse
      label: Record
      help: 'Arm the shortcut recorder for Open Manager: press the desired key combo -- the first non-modifier key commits it with whatever modifiers are held. If the combo already drives another action, a dialog explains and recording continues. Esc cancels; times out after 10 seconds.'
    - name: Shortcutupdateall
      style: Str
      label: Update All Externalizations
      startSection: true
      default: ctrl+shift+u
      help: 'Keyboard shortcut for Update All Externalizations. Lowercase combo like ''cmd+shift+o'' or ''ctrl+shift+o'': modifiers joined with ''+'' plus one trigger key. ctrl and cmd are distinct keys on macOS (matched exactly); on Windows/Linux, which has no Cmd key, a cmd binding fires via Ctrl. Each combo may be assigned to only one action. Leave empty to disable. Edit by hand or pulse Record below.'
      value: cmd+shift+u
    - name: Recordupdateall
      style: Pulse
      label: Record
      help: 'Arm the shortcut recorder for Update All Externalizations: press the desired key combo -- the first non-modifier key commits it with whatever modifiers are held. If the combo already drives another action, a dialog explains and recording continues. Esc cancels; times out after 10 seconds.'
    - name: Shortcutupdatecomp
      style: Str
      label: Update Current COMP
      startSection: true
      default: ctrl+alt+u
      help: 'Keyboard shortcut for Update Current COMP. Lowercase combo like ''cmd+shift+o'' or ''ctrl+shift+o'': modifiers joined with ''+'' plus one trigger key. ctrl and cmd are distinct keys on macOS (matched exactly); on Windows/Linux, which has no Cmd key, a cmd binding fires via Ctrl. Each combo may be assigned to only one action. Leave empty to disable. Edit by hand or pulse Record below.'
      value: cmd+alt+u
    - name: Recordupdatecomp
      style: Pulse
      label: Record
      help: 'Arm the shortcut recorder for Update Current COMP: press the desired key combo -- the first non-modifier key commits it with whatever modifiers are held. If the combo already drives another action, a dialog explains and recording continues. Esc cancels; times out after 10 seconds.'
    - name: Shortcutrefresh
      style: Str
      label: Refresh Tracking
      startSection: true
      default: ctrl+shift+r
      help: 'Keyboard shortcut for Refresh Tracking. Lowercase combo like ''cmd+shift+o'' or ''ctrl+shift+o'': modifiers joined with ''+'' plus one trigger key. ctrl and cmd are distinct keys on macOS (matched exactly); on Windows/Linux, which has no Cmd key, a cmd binding fires via Ctrl. Each combo may be assigned to only one action. Leave empty to disable. Edit by hand or pulse Record below.'
      value: cmd+shift+r
    - name: Recordrefresh
      style: Pulse
      label: Record
      help: 'Arm the shortcut recorder for Refresh Tracking: press the desired key combo -- the first non-modifier key commits it with whatever modifiers are held. If the combo already drives another action, a dialog explains and recording continues. Esc cancels; times out after 10 seconds.'
    - name: Shortcutexportproject
      style: Str
      label: Export Project to TDXN
      startSection: true
      default: ctrl+shift+e
      help: 'Keyboard shortcut for Export Project to TDXN. Lowercase combo like ''cmd+shift+o'' or ''ctrl+shift+o'': modifiers joined with ''+'' plus one trigger key. ctrl and cmd are distinct keys on macOS (matched exactly); on Windows/Linux, which has no Cmd key, a cmd binding fires via Ctrl. Each combo may be assigned to only one action. Leave empty to disable. Edit by hand or pulse Record below.'
      value: cmd+shift+e
    - name: Recordexportproject
      style: Pulse
      label: Record
      help: 'Arm the shortcut recorder for Export Project to TDXN: press the desired key combo -- the first non-modifier key commits it with whatever modifiers are held. If the combo already drives another action, a dialog explains and recording continues. Esc cancels; times out after 10 seconds.'
    - name: Shortcutexportcomp
      style: Str
      label: Export Current COMP to TDXN
      startSection: true
      default: ctrl+alt+e
      help: 'Keyboard shortcut for Export Current COMP to TDXN. Lowercase combo like ''cmd+shift+o'' or ''ctrl+shift+o'': modifiers joined with ''+'' plus one trigger key. ctrl and cmd are distinct keys on macOS (matched exactly); on Windows/Linux, which has no Cmd key, a cmd binding fires via Ctrl. Each combo may be assigned to only one action. Leave empty to disable. Edit by hand or pulse Record below.'
      value: cmd+alt+e
    - name: Recordexportcomp
      style: Pulse
      label: Record
      help: 'Arm the shortcut recorder for Export Current COMP to TDXN: press the desired key combo -- the first non-modifier key commits it with whatever modifiers are held. If the combo already drives another action, a dialog explains and recording continues. Esc cancels; times out after 10 seconds.'
    - name: Shortcutcopytdxn
      style: Str
      label: Copy Selected COMP as TDXN
      startSection: true
      default: ctrl+shift+c
      help: 'Keyboard shortcut for Copy Selected COMP as TDXN. Lowercase combo like ''cmd+shift+o'' or ''ctrl+shift+o'': modifiers joined with ''+'' plus one trigger key. ctrl and cmd are distinct keys on macOS (matched exactly); on Windows/Linux, which has no Cmd key, a cmd binding fires via Ctrl. Each combo may be assigned to only one action. Leave empty to disable. Edit by hand or pulse Record below.'
      value: cmd+shift+c
    - name: Recordcopytdxn
      style: Pulse
      label: Record
      help: 'Arm the shortcut recorder for Copy Selected COMP as TDXN: press the desired key combo -- the first non-modifier key commits it with whatever modifiers are held. If the combo already drives another action, a dialog explains and recording continues. Esc cancels; times out after 10 seconds.'
    - name: Shortcuttagger
      style: Menu
      label: Tagger Double-Tap Key
      startSection: true
      default: lctrl
      menuSource: op('./shortcuts').module.taggerMenu()
      help: 'Modifier key that opens the tagger for the operator under the cursor when double-tapped (two presses within half a second). Entries are physical keys and adapt per platform: macOS offers Left Ctrl plus left/right Cmd (Apple keyboards have no right Ctrl); Windows/Linux offers left/right Ctrl (no Cmd key). A choice a platform''s keyboard lacks falls back to its closest key -- the saved value is never rewritten, so it round-trips between platforms intact. Off disables the tagger shortcut.'
    - name: Resetshortcuts
      style: Pulse
      label: Reset Shortcuts to Defaults
      startSection: true
      help: Restore all keyboard shortcuts (and the tagger double-tap key) to factory defaults.
    Adv:
    - name: Createexternalizationstable
      style: Pulse
      label: Create Externalizations Table
      startSection: true
      help: Creates the externalizations tracking table as a sibling operator if it does not already exist. Safe to pulse at any time — no-op if the table is already connected. Use this to recover if the table was lost after an Embody upgrade.
    - name: Externalizations
      style: DAT
      label: Externalizations Table
      help: Reference to the externalizations tracking table DAT (stored in TSV format). Lists all externalized operators with their paths, types, timestamps, and dirty state.
    - name: Openexternalizationstable
      style: Pulse
      label: Open Externalizations Table
      help: Opens the externalizations tracking table in a floating viewer window.
    - name: Detectduplicatepaths
      style: Toggle
      label: Detect Duplicate Paths
      startSection: true
      help: When enabled, warns if multiple operators resolve to the same externalized file path. Helps catch naming conflicts.
      value: true
    - name: Templatemaster
      style: Str
      label: Template Master Name
      default: __template__
      help: When duplicate external paths are detected, an operator whose path contains a folder/COMP with this exact name is auto-selected as the master (the rest are tagged as clones), with no prompt. Matches only when exactly one operator in the group contains this name. Clear this field to always choose the master manually, or set it to your own naming convention (e.g. '_master').
    - name: Localtimestamps
      style: Toggle
      label: Local Timestamps
      default: true
      help: When enabled, timestamps in the externalizations table are displayed in your local timezone instead of UTC.
    - name: Toxrestoreonstart
      style: Toggle
      label: Restore toxes on Start
      help: When enabled, automatically restores TOX-strategy COMPs from .tox files on disk when the project opens. Useful when COMPs were externalized but the .toe was not saved.
      value: true
    - name: Datrestoreonstart
      style: Toggle
      label: Restore DATs on Start
      default: true
      help: When enabled, automatically restores DAT-strategy operators from externalized files on disk when the project opens. Recreates missing DATs (py, json, xml, etc.) and configures file sync. Safely excludes Embody descendants and DATs inside TOX/TDXN COMPs.
    - name: Filecleanup
      style: Menu
      label: File Cleanup
      startSection: true
      default: ask
      menuNames:
      - ask
      - keep
      - delete
      menuLabels:
      - Ask
      - Always Keep Files
      - Always Delete Files
      help: 'When a deleted operator''s external file still exists on disk: Ask prompts each time, Always Keep removes the tracking entry but leaves files on disk, Always Delete removes both the entry and the file.'
      value: keep
    - name: Toxdropexpr
      style: Menu
      label: Dropped .tox Expression
      startSection: true
      default: ask
      menuNames:
      - ask
      - clean
      - ignore
      menuLabels:
      - Ask
      - Always Clean
      - Always Ignore
      help: 'How to handle the default expression TouchDesigner writes into a COMP''s External .tox when a .tox is dragged in (me.parent().fileFolder + ''/'' + ...). Ask: prompt when detected (the dialog''s Always buttons set this parameter). Always Clean: silently clear the expression. Always Ignore: silently leave it. Embody''s own descendants are always cleaned regardless.'
      value: ask
    - name: Tdxndatsafety
      style: Menu
      label: Content Safety
      default: ask
      menuNames:
      - ask
      - externalize
      - ignore
      menuLabels:
      - Warn Each Save
      - Always Externalize
      - Never Warn
      help: What a save does about TDXN content its .tdxn cannot hold. Warn Each Save logs a WARNING when a save or the next open would lose storage (Embed Storage off); Always Externalize also files unexternalized DATs as their own files after the save; Never Warn is silent. Saves never show a dialog.
    - name: Showbuiltinpars
      style: Toggle
      label: Show Built-in Pars
      startSection: true
      help: Show TouchDesigner's built-in parameter pages (Layout, Panel, Look, Children, Drag/Drop, Extensions, Common) alongside Embody's pages in this dialog. Off (default) filters the dialog to Embody's pages only. The built-in pages remain fully functional either way -- this only controls dialog visibility, e.g. turn it on to reach the Common page's Global OP Shortcut.
    - name: Verbose
      style: Toggle
      label: Verbose (Debug)
      startSection: true
      help: Enables debug-level logging. When off, only INFO and above are logged. Enable for detailed diagnostics when troubleshooting issues.
    - name: Print
      style: Toggle
      label: Print to Textport
      help: Echoes all log messages to the TouchDesigner textport. Useful for monitoring Embody activity in real-time.
      value: true
    - name: Logtofile
      style: Toggle
      label: Log to File
      help: Writes log messages to a file on disk. Files are saved to the Log Folder with automatic rotation at 10 MB.
      value: true
    - name: Logfolder
      style: Folder
      label: Log Folder
      help: Folder where log files are saved. Defaults to dev/logs/ in the project directory. Files are named <project>_YYMMDD.log.
      value: logs
    - name: Uninstall
      style: Pulse
      startSection: true
      help: 'Removes Embody from this project: deletes Embody-generated config (CLAUDE.md / AGENTS.md / .claude / .cursor / ...), Embody''s .venv, and .embody/ state; strips only Embody''s block from shared files (.gitignore, .gitattributes, .mcp.json); un-sets the .tdxn git diff driver. Your own files, externalized .tox / .tdxn / .py, and the Embody COMP are NOT removed. Asks for confirmation first.'
    About:
    - name: Version
      style: Str
      startSection: true
      readOnly: true
      help: Embody version string (read-only).
      value: 6.2.65
    - name: Touchbuild
      style: Str
      label: Touch Build
      readOnly: true
      help: TouchDesigner build number this version was developed on (read-only).
      value: '2025.33230'
    - name: Author
      style: Str
      readOnly: true
      help: Embody author (read-only).
      value: Dylan Roscover
    - name: Build
      style: Int
      label: Build Number
      readOnly: true
      help: Embody build number (read-only). Incremented with each release.
    - name: Github
      style: Pulse
      label: GitHub
      startSection: true
      help: Opens the Embody GitHub repository in your web browser.
    - name: Date
      style: Str
      label: Build Date
      readOnly: true
      help: Date of this Embody build (read-only).
    - name: Help
      style: Pulse
      help: Opens the Embody help documentation.
    - name: Autoupdate
      style: Menu
      label: Auto-Update
      startSection: true
      default: 'off'
      menuNames:
      - 'off'
      - notify
      - install
      menuLabels:
      - 'Off'
      - Check and Notify
      - Check and Install
      help: 'Startup self-update behavior. Off: never checks (nothing leaves your machine). Check and Notify: checks GitHub once at startup and shows availability in Update Status without installing. Check and Install: installs a verified newer release automatically at startup -- a check that can''t complete is logged quietly, but any failure during the install itself always raises a dialog. Persisted setting -- survives the update it triggers. See the Auto-Update docs page.'
    - name: Checkforupdate
      style: Pulse
      label: Check for Update
      help: Checks GitHub for a newer Embody release now. Prompts with the version pair and a release-notes link if one is available (install / not now); reports up-to-date and network errors in a dialog. Refused in the dev checkout (update via git instead).
    - name: Updatestatus
      style: Str
      label: Update Status
      default: Disabled
      readOnly: true
      help: 'Result of the last update check or install: Disabled while Auto-Update is Off (the fresh-install resting state), up to date, a newer version available, download/install progress, or an error summary (read-only).'
      value: Disabled
  flags:
  - display
  - viewer
  - showCustomOnly
  position: [125, -125]
  size: [160, 130]
  children:
  - name: help
    type: opviewerCOMP
    parameters:
      opviewer: ./text_help_display
      w: 500
      h: 600
      display: false
      resizecomp: =me
      repocomp: =me
      topsmoothness: mipmap
      borderover: false
      reloadbuiltin: false
    position: [196, 675]
    size: [142, 155]
    color: [0.325, 0.8, 0.3]
    tags:
    - tox
    children:
    - name: text_help
      type: textDAT
      parameters:
        file: Embody/help/text_help.py
        syncfile: true
        language: python
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: text_help_display
      type: textDAT
      parameters:
        file: Embody/help/text_help_display.py
        syncfile: true
        language: python
      position: [0, -200]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
  - name: list
    type: containerCOMP
    parameters:
      w: 996
      h: 40
      hmode: fill
      vmode: fill
      alignorder: 1
      resizeb: true
      resizewmin: 400
      resizewmax: 3840
      resizehmin: 40
      resizehmax: 2160
      bgcolorr: =parent.Embody.par.Backgroundcolorr
      bgcolorg: =parent.Embody.par.Backgroundcolorg
      bgcolorb: =parent.Embody.par.Backgroundcolorb
      bgalpha: =parent.Embody.par.Backgroundcolora
      borderover: false
      marginl: 5
      marginr: 5
      reloadbuiltin: false
    position: [300, 75]
    size: [160, 86]
    comp_inputs:
    - manager
    children:
    - name: list1
      type: listCOMP
      parameters:
        callbacks: =op('list_callbacks')
        rows: =op('inject_parents').numRows
        cols: 8
        lockfirstrow: true
        offcellcallbacks: true
        hmode: fill
        vmode: fill
      position: [445, 0]
    - name: select1
      type: selectDAT
      parameters:
        dat: =parent.Embody.par.Externalizations
      position: [-275, 0]
      dat_read_only: true
    - name: inject_parents
      type: scriptDAT
      parameters:
        callbacks: inject_parents_callbacks
      position: [-100, 0]
      inputs:
      - select1
      dat_read_only: true
    - name: list_callbacks
      type: textDAT
      parameters:
        file: Embody/list/list_callbacks.py
        syncfile: true
        language: python
      position: [625, 0]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
    - name: inject_parents_callbacks
      type: textDAT
      parameters:
        file: Embody/list/inject_parents_callbacks.py
        syncfile: true
        language: python
      flags:
      - viewer
      position: [-100, -120]
      size: [130, 90]
      color: [0.9, 0.3, 0.4]
      tags:
      - py
      dock: inject_parents
  - name: fifo1
    type: fifoDAT
    parameters:
      callbacks: fifo1_callbacks
      fromop: =parent()
      maxlines: 100
