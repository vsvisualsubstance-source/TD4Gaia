            font: Open Sans
            fontsize: 9
            fontsizeunits: points
            fontcolorr: =parent.Embody.par.Textcolorr
            fontcolorg: =parent.Embody.par.Textcolorg
            fontcolorb: =parent.Embody.par.Textcolorb
