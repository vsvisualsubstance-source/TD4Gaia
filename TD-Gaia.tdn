          position: [0, 400]
          color: [0.67, 0.67, 0.67]
        - name: select_lights_canvas
          type: selectCHOP
          parameters:
            chops: ../canvas_bridge
            channames: gaia/canvas/lights/Area_TV_Zone_Colore/power gaia/canvas/lights/Area_TV_Zone_Colore/brightness gaia/canvas/lights/Area_TV_Zone_Luminosita/power gaia/canvas/lights/Area_TV_Zone_Luminosita/brightness gaia/canvas/lights/Area_TV_Zone_Potenza/power gaia/canvas/lights/Area_TV_Zone_Potenza/brightness gaia/canvas/lights/Hue_tap_switch_1_Stato_interruttore_a_pulsante/power gaia/canvas/lights/Hue_tap_switch_1_Stato_interruttore_a_pulsante/brightness gaia/canvas/lights/Hue_tap_switch_1_Ultimo_aggiornamento/power gaia/canvas/lights/Hue_tap_switch_1_Ultimo_aggiornamento/brightness gaia/canvas/lights/Luce_Corridoio_Allerta/power gaia/canvas/lights/Luce_Corridoio_Allerta/brightness gaia/canvas/lights/Luce_Corridoio_Luminosita/power gaia/canvas/lights/Luce_Corridoio_Luminosita/brightness gaia/canvas/lights/Luce_Salotto_Allerta/power gaia/canvas/lights/Luce_Salotto_Allerta/brightness gaia/canvas/lights/Luce_Salotto_Colore/power gaia/canvas/lights/Luce_Salotto_Colore/brightness gaia/canvas/lights/Sala_Colore/power gaia/canvas/lights/Sala_Colore/brightness gaia/canvas/lights/Sala_Luminosita/power gaia/canvas/lights/Sala_Luminosita/brightness gaia/canvas/lights/Sala_Potenza/power gaia/canvas/lights/Sala_Potenza/brightness gaia/canvas/lights/Soggiorno_Colore/power gaia/canvas/lights/Soggiorno_Colore/brightness gaia/canvas/lights/Soggiorno_Luminosita/power gaia/canvas/lights/Soggiorno_Luminosita/brightness gaia/canvas/lights/Soggiorno_Potenza/power gaia/canvas/lights/Soggiorno_Potenza/brightness gaia/canvas/lights/Tutte_le_luci_Colore/power gaia/canvas/lights/Tutte_le_luci_Colore/brightness gaia/canvas/lights/Tutte_le_luci_Luminosita/power gaia/canvas/lights/Tutte_le_luci_Luminosita/brightness gaia/canvas/lights/Tutte_le_luci_Potenza/power gaia/canvas/lights/Tutte_le_luci_Potenza/brightness gaia/canvas/lights/Zona_Notte_Zone_Colore/power gaia/canvas/lights/Zona_Notte_Zone_Colore/brightness gaia/canvas/lights/Zona_Notte_Zone_Luminosita/power gaia/canvas/lights/Zona_Notte_Zone_Luminosita/brightness gaia/canvas/lights/Zona_Notte_Zone_Potenza/power gaia/canvas/lights/Zona_Notte_Zone_Potenza/brightness gaia/canvas/lights/luce_Ingresso_Colore/power gaia/canvas/lights/luce_Ingresso_Colore/brightness gaia/canvas/lights/luce_Ingresso_Luminosita/power gaia/canvas/lights/luce_Ingresso_Luminosita/brightness gaia/canvas/lights/luce_Ingresso_Potenza/power gaia/canvas/lights/luce_Ingresso_Potenza/brightness gaia/canvas/lights/unknown/power gaia/canvas/lights/unknown/brightness
          color: [0.67, 0.67, 0.67]
        annotations:
        - name: annotate1
          mode: annotate
          title: Gaia Canvas Data (parallel schema)
          text: 'Extracts the new gaia/canvas/* OSC namespace, mirroring data''s select->lag->null pattern. Runs alongside the legacy data COMP (gaia/soul, gaia/rooms, gaia/lights) without replacing it. mood_rgb uses a long (1.2s) lag so scene color never snaps; soul/rooms/lights/tccm use short lags matching existing conventions. tccm row (added 2026-09-03) extracts the Sennheiser TCC M ceiling mic array''s beam-tracking feed: online, azimuth (deg), elevation (deg), room_active, muted -- confirmed live on canvas_bridge, not yet wired to any visual consumer.'
          position: [-70, -470]
          size: [1070, 1930]
          color: [0.45, 0.45, 0.45]
      - name: dream_light
        type: lightCOMP
        position: [2250, -1275]
        children:
        - name: copy1
          type: copyPOP
          position: [520, 670]
          inputs:
          - tube_attenuated
        - name: merge1
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
            - {}
            - {}
            - {}
            - {}
            - {}
          position: [250, 500]
          inputs:
          - rectangle1
          - tube_cone1
          - tube_cone2
          - primitive1
          - line_atten
          - circle_attenStart
          - circle_attenEnd
        - name: merge2
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
          position: [950, 230]
          inputs:
          - connectivity1
          - circle1
        - name: merge3
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
          position: [620, 290]
          inputs:
          - pointgen1
          - transform1
        - name: circle1
          type: circlePOP
          parameters:
            scale: 0.2
          position: [780, 170]
        - name: sphere1
          type: spherePOP
          parameters:
            radx: 0.05
            rady: 0.05
            radz: 0.05
            freq: 3
          position: [520, 890]
        - name: pointgen1
          type: pointgeneratorPOP
          position: [270, 290]
        - name: line_atten
          type: linePOP
          sequences:
            pt:
            - posz: =-parent().par.attenuationstart
            - posz: =-parent().par.attenuationend
          custom_pars:
            Points:
              $t: points_2
          position: [0, 230]
        - name: primitive1
          type: primitivePOP
          parameters:
            addpts: true
            method: pattern
          sequences:
            prim:
            - type: lines
              pattern: 0 1 0 2 0 3 0 4
            pt:
            - {}
            - posx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2)) + mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
            - posx: =mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =0-op('tube_cone1').par.height
            - posy: =-mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
            - posy: =mod.math.sin(-mod.math.radians(parent().par.coneangle/2)) - mod.math.sin(mod.math.radians(parent().par.conedelta/2))
              posz: =-op('tube_cone1').par.height
          custom_pars:
            Points:
              $t: points_2
          flags:
          - viewer
          position: [0, 390]
        - name: rectangle1
          type: rectanglePOP
          position: [0, 730]
        - name: transform1
          type: transformPOP
          parameters:
            tz: 0.8
          position: [450, 370]
          inputs:
          - pointgen1
        - name: tube_cone1
          type: tubePOP
          parameters:
            radx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2))
            rady: 0.01
            height: =mod.math.cos(mod.math.radians(parent().par.coneangle/2))
            tz: =-me.par.height*0.5
          position: [0, 620]
        - name: tube_cone2
          type: tubePOP
          parameters:
            radx: =mod.math.sin(mod.math.radians(parent().par.coneangle/2)) + mod.math.sin(mod.math.radians(parent().par.conedelta/2))
            rady: =mod.math.sin(mod.math.radians(parent().par.coneangle/2))
            height: 0
            tz: =-op('tube_cone1').par.height
          position: [0, 500]
        - name: connectivity1
          type: connectivityPOP
          position: [780, 290]
          inputs:
          - merge3
        - name: circle_attenEnd
          type: circlePOP
          parameters:
            radx: 0.1
            rady: 0.1
            tz: =-parent().par.attenuationend
            bypass: =not parent().par.attenuated
        - name: primitive_cross
          type: primitivePOP
          parameters:
            addpts: true
            method: set
            setprimtype: lines
          sequences:
            pt:
            - posx: -0.2
            - posx: 0.2
            - posy: -0.2
            - posy: 0.2
            - posz: -0.2
            - posz: 0.2
          custom_pars:
            Points:
              $t: points_2
          flags:
          - display
          - render
          - viewer
          position: [520, 1000]
        - name: tube_attenuated
          type: tubePOP
          parameters:
            surftype: rows
            radx: =parent().par.attenuationend
            rady: =parent().par.attenuationstart
            height: 0
            bypass: =not parent().par.attenuated
          position: [368, 673]
        - name: merge_pointLight
          type: mergePOP
          sequences:
            input:
            - {}
            - {}
            - {}
            - {}
          position: [760, 820]
          inputs:
          - sphere1
          - primitive_quadrants
          - copy1
        - name: switch_lightType
          type: switchPOP
          position: [1140, 500]
          inputs:
          - merge_pointLight
          - merge1
          - merge2
        - name: circle_attenStart
          type: circlePOP
          parameters:
            radx: 0.1
            rady: 0.1
            tz: =-parent().par.attenuationstart
            bypass: =not parent().par.attenuated
          position: [0, 120]
        - name: primitive_quadrants
          type: primitivePOP
          parameters:
            addpts: true
            method: set
            setprimtype: lines
          sequences:
            pt:
            - posx: 0.07
              posy: 0.07
              posz: 0.07
            - posx: -0.07
              posy: -0.07
              posz: -0.07
            - posx: -0.07
              posy: 0.07
              posz: 0.07
            - posx: 0.07
              posy: -0.07
              posz: -0.07
            - posx: 0.07
              posy: 0.07
              posz: -0.07
            - posx: -0.07
              posy: -0.07
              posz: 0.07
            - posx: -0.07
              posy: 0.07
              posz: -0.07
            - posx: 0.07
              posy: -0.07
              posz: 0.07
          custom_pars:
            Points:
              $t: points_2
          flags:
          - viewer
          position: [520, 780]
