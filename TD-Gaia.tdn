              fontsize: 12
              fontcolorr: =parent.Embody.par.Textcolorr
              fontcolorg: =parent.Embody.par.Textcolorg
              fontcolorb: =parent.Embody.par.Textcolorb
              fontalpha: =parent.Embody.par.Textcolora
              textpaddingl: 12
              textpaddingr: 3
              textpaddingb: 3
              textpaddingt: 3
              alignx: left
              hmode: fill
              vmode: fill
              clickthrough: true
              bgcolorr: =parent.Embody.par.Listrowselectcolorr if parent().panel.rollover else parent.Embody.par.Listrowcolorr
              bgcolorg: =parent.Embody.par.Listrowselectcolorg if parent().panel.rollover else parent.Embody.par.Listrowcolorg
              bgcolorb: =parent.Embody.par.Listrowselectcolorb if parent().panel.rollover else parent.Embody.par.Listrowcolorb
              bgalpha: 1
              borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorr + .2
              borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorg + .2
              borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorb + .2
              borderover: false
              reloadbuiltin: false
            flags:
            - viewer
            position: [74, 26]
            size: [113, 64]
          - name: parexec1
            type: parameterexecuteDAT
            parameters:
              op: ..
              pars: value0
              onpulse: false
              defaultreadencoding: cp1252
            flags:
            - viewer
            position: [66, -83]
            size: [128, 66]
            dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select:\n\t\tparent().panel.state = par.eval()\n\n\tif par:\n\t\toper = parent.Embody.ext.Embody.rolloverOp\n\t\ttag = op('../tags')[parent().digits, 'value'].val\n\n\t\tif parent.Embody.ext.Embody._tagger_mode == 'manage':\n\t\t\tlabel = parent().par.label.eval()\n\t\t\tif 'Remove' in label:\n\t\t\t\t# Close window first, then show confirmation dialog\n\t\t\t\tparent.Embody.ext.Embody.tagExiter()\n\t\t\t\trun(lambda o=oper, t=tag, l=label: parent.Embody.ext.Embody._dispatchTaggerButton(o, t, l),\n\t\t\t\t\tdelayFrames=2)\n\t\t\telse:\n\t\t\t\tparent.Embody.ext.Embody._dispatchTaggerButton(oper, tag, label)\n\t\t\t\tparent.Embody.ext.Embody.tagExiter()\n\t\telse:\n\t\t\t# Tag mode: toggle + immediate externalize if added\n\t\t\tparent.Embody.ext.Embody.tagSetter(oper, tag)\n\t\t\tif tag in oper.tags:\n\t\t\t\tparent.Embody.ext.Embody.externalizeImmediate(oper)\n\t\t\tparent.Embody.Refresh()\n\t\t\tparent.Embody.ext.Embody.tagExiter()\n\n\treturn\n"
            dat_content_format: text
          - name: panelexec1
            type: panelexecuteDAT
            parameters:
              panels: =parent()
              panelvalue: state
              offtoon: false
              valuechange: true
              defaultreadencoding: cp1252
            flags:
            - viewer
            position: [247, -81]
            size: [126, 62]
            dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\treturn"
