          - select_rooms_canvas
        - name: null_soul_canvas
          type: nullCHOP
          position: [800, 800]
          color: [0.67, 0.67, 0.67]
          inputs:
          - lag_soul_canvas
        - name: lag_lights_canvas
          type: lagCHOP
          parameters:
            lag1: 0.2
            lag2: 0.2
          position: [400, 0]
          inputs:
          - select_lights_canvas
        - name: null_rooms_canvas
          type: nullCHOP
          position: [800, 400]
