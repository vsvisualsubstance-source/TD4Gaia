          parameters:
            cols: 16
            rows: 8
          position: [400, 0]
        - name: glsl_mocap_info
          type: infoDAT
          parameters:
            op: glsl_mocap
          flags:
          - viewer
          position: [160, -120]
          dock: glsl_mocap
        - name: pointsprite_mocap
          type: pointspriteMAT
          parameters:
            alpha: 0.5
            pointsize: 0.2
            attenpscale: 0.6
            blending: true
            destblend: one
          position: [1060, -300]
        - name: glsl_mocap_compute
          type: textDAT
          parameters:
            file: project1/container1/Visuals/mocap_geo/glsl_mocap_compute.glsl
            language: glsl
          flags:
