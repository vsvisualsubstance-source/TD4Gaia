      - name: moodwash_out
        type: compositeTOP
        parameters:
          operand: ='add' if op('moodwash_ctrl').par.Washmode.eval() == 'Add' else 'screen'
          outputresolution: custom
          resolutionw: 1280
          resolutionh: 720
        flags:
        - viewer
        position: [1825, -325]
        inputs:
        - over_sediment
        - level_moodwash
        - level_affinitywash
      - name: person_sigil
        type: geometryCOMP
        parameters:
          material: ./pointsprite_sigil
        custom_pars:
          Nursery:
          - name: Hue
            style: Float
            startSection: true
            default: 0.5
            clampMin: true
            clampMax: true
            help: Color hue (0-1) chosen by the Nursery activation to represent the recognized person.
          - name: Shape
            style: Menu
            default: ring
            menuNames:
            - ring
            - spiral
            - cluster
            menuLabels:
            - Ring
            - Spiral
            - Cluster
            help: 'Point arrangement chosen by the Nursery activation: ring (steady orbit), spiral (winding outward), cluster (loose grouping).'
          - name: Energy
            style: Float
            default: 0.5
            clampMin: true
            clampMax: true
            help: Motion intensity/speed (0=still, 1=lively), chosen by the Nursery activation.
        position: [2050, 1000]
        size: [160, 130]
        children:
        - name: points1
          type: primitivePOP
          custom_pars:
            Points:
              $t: points
          flags:
          - display
          - render
          position: [800, 0]
          inputs:
          - glsl_sigil
        - name: glsl_sigil
          type: glslPOP
          parameters:
            computedat: glsl_sigil_compute
            outputattrs: P
          sequences:
            attr:
            - name: color
              numcomps: '3'
            - name: pointscale
            vec:
            - name: uTime
              valuex: =absTime.seconds
            - name: uHue
              valuex: =parent().par.Hue.eval()
            - name: uMod
              type: vec2
              valuex: =parent().par.Energy.eval()
              valuey: =['ring','spiral','cluster'].index(parent().par.Shape.eval())
          position: [400, 0]
          inputs:
          - grid_sigil
        - name: grid_sigil
          type: gridPOP
          parameters:
            cols: 6
            rows: 4
        - name: glsl_sigil_info
          type: infoDAT
          parameters:
            op: glsl_sigil
          flags:
          - viewer
          position: [600, -125]
          dock: glsl_sigil
        - name: pointsprite_sigil
          type: pointspriteMAT
          position: [400, -300]
        - name: glsl_sigil_compute
          type: textDAT
          parameters:
            file: project1/container1/Visuals/person_sigil/glsl_sigil_compute.glsl
            language: glsl
          flags:
          - viewer
          position: [390, -120]
          size: [130, 90]
          tags:
          - glsl
          dock: glsl_sigil
      - name: affinity_ctrl
        type: baseCOMP
        custom_pars:
          Affinity Wash:
          - name: Affinityenable
            style: Toggle
            startSection: true
            default: true
            help: Master enable for the per-person affinity/recognition glow. When off, the wash contributes nothing regardless of who is present.
          - name: Affinityamount
            style: Float
            default: 0.2
            clampMin: true
            normMax: 0.5
            help: Maximum strength of the affinity wash, scaled down further by the weighted-average affinity of whoever is currently present (a stranger barely tints the scene even at full amount).
            value: 0.0410000011
          - name: Affinitylagtime
            style: Float
            default: 1.2
            max: 10.0
            clampMin: true
            normMax: 5.0
            help: Seconds of easing applied to the affinity wash's color and intensity, so recognizing or losing a person fades the glow in/out instead of snapping.
            value: 0.8899999857
        position: [-25, -2350]
        size: [290, 322]
        color: [0.325, 0.8, 0.3]
      - name: cam_soggiorno
        type: videostreaminTOP
        parameters:
          url: http://192.168.1.240:8766/video
        flags:
        - bypass
        - viewer
        position: [3000, -1200]
      - name: canvas_bridge
        type: scriptCHOP
        parameters:
          callbacks: canvas_bridge_callbacks
        position: [1600, -1200]
        inputs:
        - canvas_bridge_clock
      - name: composite_out
        type: compositeTOP
        parameters:
          operand: screen
        flags:
        - viewer
        position: [3875, -950]
        inputs:
        - blur_bloom
        - webrender1
        - moodwash_out
        - webrender2
        - transform3
        - transform2
        - transform1
      - name: dream_render1
        type: renderTOP
        parameters:
          camera: dream_cam
          geometry: dream_fragment dream_geo
          lights: dream_light
          bgcolorr: 0.02
          bgcolorg: 0.02
          bgcolorb: 0.05
          bgcolora: 1
          resolutionw: 640
          resolutionh: 360
        position: [4375, -1275]
      - name: event_watcher
        type: scriptCHOP
        parameters:
          callbacks: event_watcher_callbacks
        position: [1600, -600]
        storage:
          last_error: |
            Traceback (most recent call last):
              File "/project1/container1/Visuals/event_watcher_callbacks", line 3, in onCook
              File "/project1/container1/Visuals/event_watcher_callbacks", line 29, in _onCookImpl
            AttributeError: 'NoneType' object has no attribute 'par'
          dbg_bare: /project1/container1/Visuals/event_ctrl
          dbg_dot1: None
          dbg_dot2: None
          dbg_me: /project1/container1/Visuals/event_watcher_callbacks
          dbg_me_parent: /project1/container1/Visuals
          prev_levelup: 0
          prev_dreamnew: 0
      - name: math_dmx_wash
        type: mathCHOP
        parameters:
          gain: =op('dmx_ctrl').par.Lightscale.eval()
          postoff: =((op('data_canvas/null_mood_rgb')['gaia/canvas/soul/mood_rgb/r']/255.0 + op('data_canvas/null_mood_rgb')['gaia/canvas/soul/mood_rgb/g']/255.0 + op('data_canvas/null_mood_rgb')['gaia/canvas/soul/mood_rgb/b']/255.0)/3.0) * op('dmx_ctrl').par.Washtodmxamount.eval() * 255.0
        position: [3920, 873]
        inputs:
        - select_lights_for_dmx
      - name: moodwash_ctrl
        type: baseCOMP
        custom_pars:
          Mood Wash:
          - name: Washamount
            style: Float
            label: Wash Amount
            startSection: true
            default: 0.15
            clampMin: true
            clampMax: true
            help: Blend strength of the ambient soul-mood color wash applied over the whole render before bloom. 0 = no wash, 1 = full strength.
            value: 0.1159999967
          - name: Washmode
            style: Menu
            label: Wash Mode
            default: Add
            menuNames:
            - Add
            - Screen
            help: Compositing operand used to blend the mood wash onto the render. Add reads even in pure black regions; Screen is gentler on already-bright areas.
          - name: Washlagtime
            style: Float
            label: Wash Lag Time
            default: 1.5
            max: 10.0
            clampMin: true
            normMax: 5.0
            help: Seconds of smoothing applied to the mood color before it reaches the wash, so the scene's base color eases rather than snaps when Gaia's mood changes. Drives data_canvas/lag_mood_rgb's Lag parameters.
            value: 1.4700000286
        flags:
        - viewer
        position: [325, -2350]
        size: [216, 312]
        color: [0.325, 0.8, 0.3]
      - name: over_sediment
        type: compositeTOP
        parameters:
          operand: over
          outputresolution: custom
          resolutionw: 1280
          resolutionh: 720
          format: rgba8fixed
        flags:
        - viewer
        position: [1650, -225]
        inputs:
        - render1
        - level_sediment_out
      - name: sediment_ctrl
        type: baseCOMP
        custom_pars:
          Sediment:
          - name: Sedimentreset
            style: Pulse
            label: Reset
            startSection: true
            help: Clears the accumulated lexicon-ink feedback buffer back to black in a single frame.
          - name: Sedimentdecay
            style: Float
            label: Decay
            startSection: true
            default: 0.99
            min: 0.9
            clampMin: true
            clampMax: true
            normMin: 0.9
            help: Per-frame multiplier applied to the accumulated ink before adding this frame's fresh deposit. Must stay strictly below 1.0 so the buffer can never grow unbounded - lower values fade faster, closer to 1.0 lingers longer.
            value: 0.9158
          - name: Sedimentamount
            style: Float
            label: Amount
            default: 1
            max: 3.0
            clampMin: true
            normMax: 2.0
            help: Overall visibility multiplier for the ink layer in the final composite - a faint, slow-building background texture representing Gaia's recurring words/personality, not a foreground element.
            value: 0.8500000238
        position: [0, -2750]
        size: [339, 298]
        color: [0.325, 0.8, 0.3]
      - name: dream_fragment
        type: geometryCOMP
        parameters:
          material: ./pointsprite_dreamfrag
