    name: Mqtthost
    startSection: true
    style: Str
  - clampMax: true
    clampMin: true
    default: 1883
    help: Porta TCP del broker MQTT di Gaia.
    label: MQTT Port
    max: 65535.0
    min: 1.0
    name: Mqttport
    style: Int
  audio:
