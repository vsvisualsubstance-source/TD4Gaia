      - name: plantnotes_geo
        type: geometryCOMP
        parameters:
          material: ./pointsprite_plantnotes
        flags:
        - display
        - render
        - viewer
        position: [4133, -1959]
        size: [81, 64]
        children:
        - name: points1
          type: primitivePOP
          parameters:
            keep: true
            method: set
            setprimtype: points
          custom_pars:
            Points:
              $t: points
          flags:
          - display
          - render
          position: [800, 0]
          inputs:
          - glsl_plantnotes
        - name: grid_base
          type: gridPOP
