      - name: moodwash_out
        type: compositeTOP
        parameters:
          operand: ='add' if op('moodwash_ctrl').par.Washmode.eval() == 'Add' else 'screen'
          outputresolution: custom
          resolutionw: 1280
          resolutionh: 720
        flags:
        - viewer
        position: [2400, -350]
        inputs:
        - over_sediment
        - level_moodwash
        - level_affinitywash
      - name: person_sigil
        type: geometryCOMP
        parameters:
          material: ./pointsprite_sigil
        custom_pars:
          Nursery:
          - name: Hue
            style: Float
            startSection: true
            default: 0.5
            clampMin: true
            clampMax: true
            help: Color hue (0-1) chosen by the Nursery activation to represent the recognized person.
          - name: Shape
            style: Menu
            default: ring
            menuNames:
            - ring
            - spiral
            - cluster
            menuLabels:
            - Ring
            - Spiral
            - Cluster
            help: 'Point arrangement chosen by the Nursery activation: ring (steady orbit), spiral (winding outward), cluster (loose grouping).'
          - name: Energy
            style: Float
            default: 0.5
            clampMin: true
            clampMax: true
            help: Motion intensity/speed (0=still, 1=lively), chosen by the Nursery activation.
        flags:
        - -display
        - -render
        position: [2050, 1000]
        size: [160, 130]
        children:
        - name: points1
          type: primitivePOP
          custom_pars:
            Points:
              $t: points
          flags:
          - display
          - render
          position: [800, 0]
          inputs:
          - glsl_sigil
        - name: glsl_sigil
          type: glslPOP
          parameters:
            computedat: glsl_sigil_compute
            outputattrs: P
          sequences:
            attr:
            - name: color
              numcomps: '3'
            - name: pointscale
            vec:
            - name: uTime
              valuex: =absTime.seconds
            - name: uHue
              valuex: =parent().par.Hue.eval()
            - name: uMod
              type: vec2
              valuex: =parent().par.Energy.eval()
              valuey: =['ring','spiral','cluster'].index(parent().par.Shape.eval())
          position: [400, 0]
          inputs:
          - grid_sigil
        - name: grid_sigil
          type: gridPOP
          parameters:
            cols: 6
            rows: 4
        - name: glsl_point_glow
          type: glslTOP
          parameters:
            pixeldat: glsl_point_glow_pixel
            computedat: glsl_point_glow_compute
            resolutionw: 64
            resolutionh: 64
          position: [0, -700]
        - name: glsl_sigil_info
          type: infoDAT
          parameters:
            op: glsl_sigil
          flags:
          - viewer
          position: [600, -125]
          color: [0.67, 0.67, 0.67]
          dock: glsl_sigil
          dat_read_only: true
        - name: pointsprite_sigil
          type: pointspriteMAT
          parameters:
            colormap: glsl_point_glow
          position: [400, -300]
        - name: glsl_sigil_compute
          type: textDAT
          parameters:
            file: project1/container1/Visuals/person_sigil/glsl_sigil_compute.glsl
            syncfile: true
            language: glsl
          flags:
          - viewer
          position: [390, -120]
          size: [130, 90]
          color: [0.9, 0.3, 0.4]
          tags:
          - glsl
          dock: glsl_sigil
        - name: glsl_point_glow_info
          type: infoDAT
          parameters:
            op: glsl_point_glow
          flags:
          - viewer
          position: [150, -820]
          color: [0.67, 0.67, 0.67]
          dock: glsl_point_glow
          dat_read_only: true
        - name: glsl_point_glow_pixel
          type: textDAT
          parameters:
            file: project1/container1/Visuals/person_sigil/glsl_point_glow_pixel.glsl
            syncfile: true
            language: glsl
            extension: frag
          flags:
          - viewer
          position: [0, -820]
          size: [130, 90]
          color: [0.9, 0.3, 0.4]
          tags:
          - glsl
          dock: glsl_point_glow
        - name: glsl_point_glow_compute
          type: textDAT
