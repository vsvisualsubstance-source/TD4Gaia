          Nursery:
          - name: Hue
            style: Float
            startSection: true
            default: 0.6
            clampMin: true
            clampMax: true
            help: Color hue (0-1) chosen by the Nursery activation to represent the dream's mood or content.
            value: 0
          - name: Shape
            style: Menu
            default: spiral
            menuNames:
            - ring
            - spiral
            - cluster
            menuLabels:
            - Ring
            - Spiral
            - Cluster
