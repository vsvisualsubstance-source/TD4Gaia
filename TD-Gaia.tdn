        - name: pointsprite_plantnotes
          type: pointspriteMAT
          parameters:
            alpha: 0.9
            pointsize: 0.05
            sizingmodel: perspective
            blending: true
            destblend: one
          position: [400, -300]
        - name: glsl_plantnotes_compute
          type: textDAT
          parameters:
            file: project1/container1/Visuals/plantnotes_geo/glsl_plantnotes_compute.glsl
            language: glsl
          position: [390, -120]
          size: [130, 90]
          tags:
          - glsl
          dock: glsl_plantnotes
      - name: const_moodcolor
        type: constantTOP
        parameters:
          colorr: '=tdu.tryExcept(lambda: op(''data_canvas/null_mood_rgb'')[''gaia/canvas/soul/mood_rgb/r''] / 255.0, 0.5)'
          colorg: '=tdu.tryExcept(lambda: op(''data_canvas/null_mood_rgb'')[''gaia/canvas/soul/mood_rgb/g''] / 255.0, 0.5)'
          colorb: '=tdu.tryExcept(lambda: op(''data_canvas/null_mood_rgb'')[''gaia/canvas/soul/mood_rgb/b''] / 255.0, 0.55)'
          outputresolution: custom
