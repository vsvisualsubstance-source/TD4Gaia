          file: project1/container1/Embody/EmbodyExt.py
          defaultreadencoding: cp1252
          language: python
          extension: py
        position: [-300, 600]
        size: [130, 90]
        tags:
        - py
      - name: annotate1
        type: annotateCOMP
        sequences:
          ext:
          - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
            promote: true
        custom_pars:
          Text:
            $t: text
            Titletext: Claude Config
            Bodytext: CLAUDE.md template and .claude/ rule/skill templates for user-project generation.
          Settings:
            $t: settings_2
            Mode: annotate
            Backcolorr:
            - '=me.color[0] # node color [r]'
            - =me.color[1]
            - '=me.color[2] '
          OP Viewer:
            $t: op_viewer
            Opvieweroversize: natural
          About:
            $t: about
        position: [-770, -1270]
        size: [600, 370]
        color: [0.45, 0.45, 0.45]
        palette_clone: true
      - name: annotate2
        type: annotateCOMP
        sequences:
          ext:
          - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
            promote: true
        custom_pars:
          Text:
            $t: text
            Titletext: Collection -- community / embody.tools client
            Bodytext: 'Untrusted-content layer: scans + default-inerts community TDN on paste. TDNExt delegates source==''embody.tools'' here.'
          Settings:
            $t: settings_2
            Mode: annotate
            Backcolorr:
            - '=me.color[0] # node color [r]'
            - =me.color[1]
            - '=me.color[2] '
          OP Viewer:
            $t: op_viewer
            Opvieweroversize: natural
          About:
            $t: about
        position: [130, -620]
        size: [300, 370]
        color: [0.45, 0.45, 0.45]
        palette_clone: true
