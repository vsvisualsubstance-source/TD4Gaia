        - name: chop_pose
          type: scriptCHOP
          parameters:
            callbacks: chop_pose_callbacks
          position: [800, -1800]
        - name: dat_words
          type: scriptDAT
          parameters:
            callbacks: dat_words_callbacks
          position: [800, 300]
