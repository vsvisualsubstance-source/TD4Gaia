            channames: gaia/canvas/soul/mood_rgb/r gaia/canvas/soul/mood_rgb/g gaia/canvas/soul/mood_rgb/b
          position: [0, 1200]
          color: [0.67, 0.67, 0.67]
        - name: lag_rooms_canvas
