            hmode: fill
            alignorder: 1
            bgcolorr: 0.2
            bgcolorg: 0.21
            bgcolorb: 0.205
            bgalpha: 1
            marginl: 24
            marginr: 24
          position: [0, -150]
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
