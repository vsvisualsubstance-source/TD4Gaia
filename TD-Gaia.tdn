            alignorder: 3
            clickthrough: true
            bgcolorr: 0.11
            bgcolorg: 0.12
            bgcolorb: 0.115
            bgalpha: 1
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
        - name: logic
          type: textDAT
          parameters:
            file: project1/container1/Embody/wizard/logic.py
            syncfile: true
            language: python
          position: [0, 200]
          size: [130, 90]
          color: [0.9, 0.3, 0.4]
          tags:
          - py
        - name: title
          type: textCOMP
          parameters:
            wordwrap: true
            callbacks: title_callbacks
            fontsize: 18
            fontcolorr: 0.92
            fontcolorg: 0.92
            fontcolorb: 0.92
            textoffsetx: 24
            alignx: left
            h: 30
            hmode: fill
            alignorder: 2
            clickthrough: true
            bgcolorr: 0.11
            bgcolorg: 0.12
            bgcolorb: 0.115
            bgalpha: 1
          position: [480, 0]
          size: [160, 130]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
