par_templates:
  about:
  - default: '1.0'
    help: Annotate COMP default setup version.
    name: Version
    readOnly: true
    startSection: true
    style: Str
  - help: Click to open help page.
    name: Help
    style: Pulse
  settings:
  - default: 192.168.1.142
    help: Indirizzo IP o hostname del broker MQTT di Gaia (Core/minipc).
    label: MQTT Host
    name: Mqtthost
    startSection: true
    style: Str
  - clampMax: true
    clampMin: true
    default: 1883
    help: Porta TCP del broker MQTT di Gaia.
    label: MQTT Port
    max: 65535.0
    min: 1.0
    name: Mqttport
    style: Int
  text:
  - default: Annotate
    help: Text in the title bar.
    label: Title Text
    name: Titletext
    startSection: true
    style: Str
  - clampMin: true
    default: 30
    help: Height of the title bar. Title font height adjusts automatically to fill.
    label: Title Height
    name: Titleheight
    normMax: 100.0
    normMin: 5.0
    style: Int
  - default: left
    help: Alignment of title text.
    label: Title Align
    menuLabels:
    - Left
    - Center
    - Right
    menuNames:
    - left
    - center
    - right
    name: Titlealign
    style: Menu
  - help: Text in the body area. Use an expression for newlines etc.
    label: Body Text
    name: Bodytext
    startSection: true
    style: Str
  - clampMin: true
    default: 10
    help: Size of text in the body area.
    label: Body Font Size
    name: Bodyfontsize
    normMax: 100.0
    normMin: 8.0
    style: Int
  - help: Limit the width of the text area.
    label: Limit Body Text Width
    name: Bodylimitwidth
    style: Toggle
  - clampMin: true
    default: 1000
    help: Width limit that will cause wraparound or cut-off. Measured in Panel units.
    label: Max Body Text Width
    name: Bodymaxwidth
    normMax: 2000.0
    normMin: 100.0
    style: Int
  settings_2:
  - default: comment
    help: 'Switch between Comment, Network Box, and Annotate Modes. '
    menuLabels:
    - Comment
    - Network Box
    - Annotate
    menuNames:
    - comment
    - networkbox
    - annotate
    name: Mode
    style: Menu
  - help: Converts quotes, ellipsis, and dashes to more typographically nice unicode versions.
    label: Smart Quote
    name: Smartquote
    startSection: true
    style: Toggle
  - default: true
    help: Wrap body text when it extends past right bound.
    label: Body Word Wrap
    name: Bodywordwrap
    style: Toggle
  - default: 1
    help: Background color base.
    label: Back Color
    name: Backcolorr
    startSection: true
    style: RGBA
  - clampMax: true
    clampMin: true
    default: 1
    help: Back color alpha.
    label: Back Color Alpha
    name: Backcoloralpha
    style: Float
  - clampMax: true
    clampMin: true
    default: 1
    help: Opacity of the entire Annotate.
    label: Annotate Opacity
    name: Opacity
    style: Float
  op_viewer:
  - help: Turn the visibility of the viewer specified in the OP parameter below on or off.
    label: Viewer Display
    name: Opviewerdisplay
    style: Toggle
  - help: The operator whose viewer is displayed in the Annotate.
    label: OP
    name: Opviewer
    style: OP
  - help: Allow interaction with the OP viewer.
    label: OP Viewer Interactive
    name: Opviewerinteractive
    style: Toggle
  - default: 'False'
    help: Use the Size/Aspect Override to control viewer's size in the background.
    label: Size/Aspect Override
    menuLabels:
    - Natural
    - Specify
    - Auto-Fit
    menuNames:
    - natural
    - specify
    - autofit
    name: Opvieweroversize
    startSection: true
    style: Menu
  - clampMin: true
    default: 800
    help: Diplay viewer as-if it were being displayed at this resolution. This is particularly useful for zooming into operators that don't have a built-in resolution, like CHOPs, SOPs, and DATs.
    label: Size/Aspect
    name: Opviewersize
    normMax: 1000.0
    normMin: 1.0
    style: WH
  - default: 1
    help: Scale the viewer by this factor.
    label: Scale
    name: Opviewerscale
    normMax: 2.0
    startSection: true
    style: Float
  - help: Move the border of the viewer towards left edge of Annotate when negative or towards right edge when positive.
    label: Justify X
    name: Opviewerjustifyx
    normMin: -1.0
    style: Float
  - label: Justify Y
    name: Opviewerjustifyy
    normMin: -1.0
    style: Float
  - help: When True, allow viewer to display in the Annotate title area as well as body.
    label: Cover Body and Title
    name: Opviewerfillbodytitle
    style: Toggle
  - clampMin: true
    default: 1
    help: Zoom the viewer by this scale factor without increasing the size of its display area in the Annotate.
    label: OP Viewer Zoom
    min: 0.001
    name: Opviewerzoom
    normMax: 5.0
    normMin: 1.0
    startSection: true
    style: Float
  - help: Offsets the displayed area within the viewer. Combined with OP Viewer Zoom, this lets you display a specific area of a viewer, such as a CHOP channel or table cell.
    label: OP Viewer Offset
    name: Opvieweroffsetx
    style: XYZW
  - clampMax: true
    clampMin: true
    default: 1
    help: Alpha value of the background area in the OP Viewer.
    label: Fill Alpha
    name: Opviewerfillalpha
    startSection: true
    style: Float
  points:
  - label: Point
    name: pt
    style: Sequence
  - label: Position
    name: Posx
    sequence: pt
    style: XYZW
type: baseCOMP
flags:
- display
- render
color: [0.3, 0.5, 0.9]
tags:
- tdn
operators:
- name: window1
  type: windowCOMP
  parameters:
    winop: /project1/container1/Visuals/out_null
    title: =me
  position: [450, -175]
  size: [160, 130]
- name: project1
  type: containerCOMP
  parameters:
    w: 1280
    h: 720
    top: ./out1
    borderover: false
    parentshortcut: Project
  flags:
  - viewer
  position: [200, 100]
  size: [400, 244]
  children:
  - name: container1
    type: containerCOMP
    flags:
    - viewer
    position: [250, 131]
    size: [286, 223]
    children:
    - name: Bridge
      type: baseCOMP
      position: [1400, 200]
      size: [160, 130]
      color: [0.325, 0.8, 0.3]
      children:
      - name: annotate1
        type: annotateCOMP
        sequences:
          ext:
          - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
            promote: true
        custom_pars:
          Text:
            $t: text
            Titletext: MQTT Ingest (Gaia Bus)
            Bodytext: Direct MQTT subscription to Gaia's Mosquitto bus (subscribes to everything, '#'), parallel to Node-RED (read-only, never publishes). See internal annotation for the ingest chain.
          Settings:
            $t: settings_2
            Mode: annotate
            Backcolorr:
            - '=me.color[0] # node color [r]'
            - =me.color[1]
            - '=me.color[2] '
          OP Viewer:
            $t: op_viewer
            Opvieweroversize: natural
          About:
            $t: about
        position: [-70, -70]
        size: [300, 370]
        color: [0.45, 0.45, 0.45]
        palette_clone: true
      - name: annotate2
        type: annotateCOMP
        sequences:
          ext:
          - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
            promote: true
        custom_pars:
          Text:
            $t: text
            Titletext: Web Bridge (gaia-web)
            Bodytext: Loads the existing Three.js gaia-web dashboard as a TD texture via Web Render TOP, ready to be composed with feedback/displacement/chroma key. See internal annotation for details.
          Settings:
            $t: settings_2
            Mode: annotate
            Backcolorr:
            - '=me.color[0] # node color [r]'
            - =me.color[1]
            - '=me.color[2] '
          OP Viewer:
            $t: op_viewer
            Opvieweroversize: natural
          About:
            $t: about
        position: [-70, -470]
        size: [300, 370]
        color: [0.45, 0.45, 0.45]
        palette_clone: true
      - name: annotate3
        type: annotateCOMP
        sequences:
          ext:
          - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
            promote: true
        custom_pars:
          Text:
            $t: text
            Titletext: Ollama (Local LLM)
            Bodytext: Direct HTTP call to Ollama's /api/generate, bypassing Node-RED for the live demo. See internal annotation for details.
          Settings:
            $t: settings_2
            Mode: annotate
            Backcolorr:
            - '=me.color[0] # node color [r]'
            - =me.color[1]
            - '=me.color[2] '
          OP Viewer:
            $t: op_viewer
            Opvieweroversize: natural
          About:
            $t: about
        position: [-70, -870]
        size: [300, 370]
        color: [0.45, 0.45, 0.45]
        palette_clone: true
      - name: annotate4
        type: annotateCOMP
        sequences:
          ext:
          - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
            promote: true
        custom_pars:
          Text:
            $t: text
            Titletext: GAIA Device Agent (gaia_client)
            Bodytext: 'Text DAT + Execute DAT + un mqttclientDAT nativo (mqtt_device), tutto dentro il progetto TD (nessun processo esterno, nessuna dipendenza pip). Si annuncia in Admin/Pi Manager via MQTT (gaia/device/{id}/status, comandi enable/disable/restart) e pubblica il proprio ip. Migrato 2026-08-29 dal vecchio gaia_agent bespoke al gaia_client Universale condiviso con PatchDeck/DMX/ControllerV7 (GAIA_INTERFACE.md, "Gaia Agent Universale") -- aggiunge Family (="gaia"), Identitystatus (self-check Deviceid/Family), self-heal generico della registrazione servizi, e fallback Tailscale sul beacon discovery (Brokerhost/Tailscalehost indipendenti da gaia_config, stesso pattern self-contained degli altri 3 progetti). Canvas/Mocap/Fleet-control ingest del bundle sono disattivati (Canvasingest/Mocapingest/Devicecontrol=0): questo progetto ha gia'' le proprie pipeline native (Visuals/data_canvas via OSC, Visuals/mocap_bridge, gaia_control). gaia_services (a destra) registra i 4 servizi reali di questo progetto (osc_in/render/dmx_out/mocap_bridge) via register_project_registrar().'
          Settings:
            $t: settings_2
            Mode: annotate
            Backcolorr:
            - '=me.color[0] # node color [r]'
            - =me.color[1]
            - '=me.color[2] '
          OP Viewer:
            $t: op_viewer
            Opvieweroversize: natural
          About:
            $t: about
        position: [-70, -1270]
        size: [660, 370]
        color: [0.45, 0.45, 0.45]
        palette_clone: true
      - name: annotate5
        type: annotateCOMP
        sequences:
          ext:
          - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
            promote: true
        custom_pars:
          Text:
            $t: text
            Titletext: GAIA Service Control
            Bodytext: 'Complementare a GAIA Device Agent: qui TD e'' il CONTROLLORE, non un device. Un mqttclientDAT nativo (mqtt_control) ascolta gaia/device/+/status da tutti i device Gaia (Pi/OPS/Core) e mantiene devices_table (una riga per device+servizio) pronta per un bind a un List COMP. send_command(device_id, service, action) per play/stop/restart dai bottoni UI. Le callback girano gia'' sul thread principale di TD — nessun thread Python/queue necessario, nessuna dipendenza pip. Verificato dal vivo: device reali (Core/OPS/Pi/questo td-agent) visti subito dopo la connessione.'
          Settings:
            $t: settings_2
            Mode: annotate
            Backcolorr:
            - '=me.color[0] # node color [r]'
            - =me.color[1]
            - '=me.color[2] '
          OP Viewer:
            $t: op_viewer
            Opvieweroversize: natural
          About:
            $t: about
        position: [-70, -1670]
        size: [300, 370]
        color: [0.45, 0.45, 0.45]
        palette_clone: true
      - name: annotate6
        type: annotateCOMP
        sequences:
          ext:
          - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
            promote: true
        custom_pars:
          Text:
            $t: text
            Titletext: Deployment Config
            Bodytext: 'Punto unico di configurazione per il deploy su un''altra macchina/rete: Brokerhost/Brokerport (MQTT), Corehost (OSC/Web/Ollama), Opsdevice (device_id del nodo OPS per il mocap diretto, letto da Visuals/mocap_bridge/MocapBridgeExt invece di essere cablato). mqtt_bridge, gaia_control, web_bridge, ollama_bridge e MoodNudge leggono Brokerhost/Corehost via espressione invece di IP hardcoded. Eccezione dal 2026-08-29: gaia_client (GAIA Device Agent) ha il proprio Brokerhost/Tailscalehost indipendenti -- stesso pattern self-contained di PatchDeck/DMX/ControllerV7, non bindato qui, per non entrare in conflitto con il suo beacon_discovery interno (che scrive su Brokerhost come valore costante). camera_resolver risolve inoltre l''IP di ogni videostreaminTOP (Visuals/cam_*) a runtime dal registro device MQTT (stanza + capabilities.camera), cosi'' anche le camere non dipendono da un IP fisso.'
          Settings:
            $t: settings_2
            Mode: annotate
            Backcolorr: [0.45, 0.45, 0.45]
          OP Viewer:
            $t: op_viewer
            Opvieweroversize: natural
          About:
            $t: about
        position: [-70, -2140]
        size: [300, 370]
        color: [0.45, 0.45, 0.45]
        palette_clone: true
      - name: web_bridge
        type: baseCOMP
        custom_pars:
          Web:
          - name: Weburl
            style: Str
            label: Gaia Web URL
            startSection: true
            default: http://localhost:1880/gaia-web/
            help: URL della dashboard Three.js esistente di Gaia (servita da Node-RED), caricata dentro TD via Web Render TOP come texture componibile (feedback/displacement/chroma key).
          - name: Reload
            style: Pulse
            label: Reload Page
            help: Ricarica la pagina web corrente in webrender1 (equivalente a Reload Current Page).
        position: [0, -400]
        size: [160, 130]
        color: [0.325, 0.8, 0.3]
        children:
        - name: web_out
          type: nullTOP
          flags:
          - viewer
          position: [330, 0]
          size: [130, 90]
          inputs:
          - webrender1
        - name: annotate1
          type: annotateCOMP
          sequences:
            ext:
            - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
              promote: true
          custom_pars:
            Text:
              $t: text
              Titletext: Web Bridge (gaia-web)
              Bodytext: |-
                webrender1 (Web Render TOP) loads Weburl (custom par, default http://localhost:1880/gaia-web/) and outputs it as a texture at a bounded 1280x720, terminated in web_out (Null TOP, viewer on) for other consumers. Reload (custom pulse par) is relayed to webrender1's own Reload Current Page pulse via reload_relay (Parameter Execute DAT).

                Interactivity: web_panel (Container COMP) shows webrender1 as its Background TOP (par 'top') at 1280x720 - Container/Panel-family COMPs get live pointer channels (panel.u/v/select) once anything is displayed and the panel is hovered/clicked, whether or not a Background TOP is set. web_interact (Panel Execute DAT, watching web_panel's u/v/select on Value Change) forwards the pointer into webrender1.interactMouse(u, v, left=bool(select), pixels=False) every time any of the three changes - a continuous position+button-state feed, matching the documented interaction model (True=virtual mouse down, held True=drag, False=move with button up), not one-shot click events. Mouse wheel scroll enabled on web_panel.

                Only left-click + move + scroll are wired. Keyboard forwarding (webrenderTOP.sendKey()/sendString(), documented but unbuilt) would need a Keyboard In DAT gated on web_panel's rollover/inside so it doesn't steal TD's own shortcuts - not built this pass, no text-input need surfaced yet. The Palette webBrowser component (which wires all of this out of the box, including keyboard) was considered and rejected - Derivative's own docs say it is Windows-only, and this project runs on macOS.
            Settings:
              $t: settings_2
              Mode: annotate
              Backcolorr:
              - '=me.color[0] # node color [r]'
              - =me.color[1]
              - '=me.color[2] '
            OP Viewer:
              $t: op_viewer
              Opvieweroversize: natural
            About:
              $t: about
          position: [-70, -190]
          size: [1100, 490]
          color: [0.45, 0.45, 0.45]
          palette_clone: true
        - name: web_panel
          type: containerCOMP
          parameters:
            w: 1280
            h: 720
            mousewheel: true
            top: webrender1
          position: [800, 0]
          size: [160, 130]
        - name: web_window
          type: windowCOMP
          parameters:
            winop: web_panel
            title: =me
            winw: 1280
            winh: 720
            interact: true
          position: [1130, 0]
          size: [160, 130]
        - name: webrender1
          type: webrenderTOP
          parameters:
            url: ='http://%s:1880/portal.html' % me.parent().parent().op('gaia_config').par.Corehost.eval()
          size: [130, 90]
        - name: reload_relay
          type: parameterexecuteDAT
          parameters:
            op: ..
            pars: Reload
            file: project1/container1/Bridge/web_bridge/reload_relay.py
            syncfile: true
          position: [0, -120]
          size: [130, 90]
          color: [0.9, 0.3, 0.4]
          tags:
          - py
        - name: web_interact
          type: panelexecuteDAT
          parameters:
            panels: web_panel
            panelvalue: u v select
            offtoon: false
            file: project1/container1/Bridge/web_bridge/web_interact.py
            syncfile: true
          position: [800, -120]
          size: [130, 90]
          color: [0.9, 0.3, 0.4]
          tags:
          - py
        annotations:
        - name: annotate1
          mode: annotate
          title: Web Bridge (gaia-web)
          text: |-
            webrender1 (Web Render TOP) loads Weburl (custom par, default http://localhost:1880/gaia-web/) and outputs it as a texture at a bounded 1280x720, terminated in web_out (Null TOP, viewer on) for other consumers. Reload (custom pulse par) is relayed to webrender1's own Reload Current Page pulse via reload_relay (Parameter Execute DAT).

            Interactivity: web_panel (Container COMP) shows webrender1 as its Background TOP (par 'top') at 1280x720 - Container/Panel-family COMPs get live pointer channels (panel.u/v/select) once anything is displayed and the panel is hovered/clicked, whether or not a Background TOP is set. web_interact (Panel Execute DAT, watching web_panel's u/v/select on Value Change) forwards the pointer into webrender1.interactMouse(u, v, left=bool(select), pixels=False) every time any of the three changes - a continuous position+button-state feed, matching the documented interaction model (True=virtual mouse down, held True=drag, False=move with button up), not one-shot click events. Mouse wheel scroll enabled on web_panel.

            Only left-click + move + scroll are wired. Keyboard forwarding (webrenderTOP.sendKey()/sendString(), documented but unbuilt) would need a Keyboard In DAT gated on web_panel's rollover/inside so it doesn't steal TD's own shortcuts - not built this pass, no text-input need surfaced yet. The Palette webBrowser component (which wires all of this out of the box, including keyboard) was considered and rejected - Derivative's own docs say it is Windows-only, and this project runs on macOS.
          position: [-70, -190]
          size: [1100, 490]
          color: [0.45, 0.45, 0.45]
      - name: gaia_client
        type: baseCOMP
        parameters:
          parentshortcut: GaiaClient
        custom_pars:
          Config:
          - name: Brokerhost
            style: Str
            label: Broker Host
            startSection: true
            default: 192.168.1.142
            help: MQTT broker IP address for Gaia's LAN broker (mosquitto). Not localhost -- point this at the actual Gaia broker host for the deployment.
          - name: Brokerport
            style: Int
            label: Broker Port
            default: 1883
            help: MQTT broker TCP port. Standard unencrypted MQTT port is 1883.
          - name: Tailscalehost
            style: Str
            label: Tailscale Host
            default: core-node-0.tail62079e.ts.net
            help: 'Optional fallback broker host (Tailscale hostname or IP) used ONLY when the LAN is unreachable: neither mqtt_ingest nor mqtt_device is connected AND no beacon reply has been heard for ~90s. Beacon Discovery''s LAN self-correction always stays primary -- this never overrides a reachable LAN broker, and does nothing (stays disconnected, never blocks) if left blank. GAIA_INTERFACE.md section 3 (Gaia Agent Universale, 2026-08-29).'
          - name: Deviceid
            style: Str
            label: Device ID
            startSection: true
            help: 'Gaia device registry identity, published as gaia/device/{id}/status. Leave blank to auto-generate ''td-{project name}-{6-char hash of the project''s absolute folder}'' (gaia_device_agent.py _read_config/_project_key) -- stable across restarts, and distinct even when two different projects share a .toe filename. Was previously hostname-based (td-{hostname}), which collided when multiple TD instances ran on the same machine -- fixed 2026-08-28. Set this explicitly (and uniquely) only for the one case auto-generation can''t disambiguate: two live TD processes launched off the EXACT SAME project folder at once.'
            value: TD-Gaia
          - name: Stanza
            style: Str
            label: Room
            help: Room/zone this TD instance claims in Gaia's roomGraph (room_claim on announce). Leave blank if not tied to a specific physical room.
            value: studio
          - name: Name
            style: Str
            label: Display Name
            default: GaiaClient
            help: Human-readable display name shown in Gaia's Pi Manager/device list.
            value: Gaia Agent
          - name: Family
            style: Str
            help: Gaia project family -- declares WHICH TD PROJECT this instance belongs to (e.g. 'dmx', 'patchdeck', 'gaia'), shared by every instance of that project. Distinct from Deviceid, which identifies the individual instance -- Deviceid distinguishes the instance, Family distinguishes the project. Feeds the channel-5 matrix topic name (gaia/devices/{id}/{family}_matrix, built in the project-specific services script, not gaia_client itself) and is included in the status/profile MQTT payloads so Gaia-side consumers (Admin, watchdog) can group/filter by project without hand-maintained device_id lists or regexes. Leave blank only if this instance intentionally has no channel-5 matrix to publish.
            value: gaia
          Services:
          - name: Canvasingest
            style: Toggle
            label: Canvas Ingest
            startSection: true
            default: true
            help: Enable ingest of gaia/td/canvas, gaia/brain/state, gaia/brain/dream MQTT topics into topic_canvas/topic_brainstate/topic_dream and their derived soul/lexicon/thought outputs. The MQTT connection itself always stays up when the component is active; this only gates whether incoming messages are stored/processed -- never toggle mqttclientDAT.par.active directly, that has crashed TD before.
            value: false
          - name: Devicestatus
            style: Toggle
            label: Device Status
            help: 'Enable Gaia device registry: periodic gaia/device/{id}/status heartbeat, gaia/devices/{id}/announce+profile, and remote enable/disable/restart/set commands. Disabling this stops publishing/command handling but keeps the MQTT connection alive (same crash-avoidance reasoning as Canvas Ingest).'
            value: true
          - name: Reregister
            style: Pulse
            label: Re-register Services
            help: Manually retries the project's service/param registration (whatever was passed to gaia_device_agent.register_project_registrar() -- e.g. PatchDeck's register_all()) without restarting TD. Same recovery this component already does automatically when the registry is found empty (self-check in tick()); use this to force it immediately instead of waiting. No-op (logged) if the project never called register_project_registrar(). GAIA_INTERFACE.md section 2.
          - name: Mocapingest
            style: Toggle
            label: Direct Mocap Ingest (OSC)
            help: 'Enable direct OSC mocap ingest from a Gaia OPS node running mediapipe_node.py (face/hand/pose landmarks on UDP port 7000). Requires Devicestatus enabled too -- the OPS node discovers this TD instance''s IP via the device status heartbeat. Safe to toggle live: gates an OSC In CHOP, not a mqttclientDAT.'
          - name: Devicecontrol
            style: Toggle
            label: Device Fleet Control
            help: 'Enable Gaia fleet control: subscribe to gaia/device/+/status for ALL Gaia devices (not just this one), maintain a live devices_table (device_id/name/stanza/role/service/state/offline), and expose gaia_client_control.send_command(device_id, service, action) for enable/disable/restart. Independent of Device Status above -- that makes THIS instance a controllable device; this makes it a controller of the whole fleet. Ported from TD-Gaia''s td_service_control.py. No bundled UI panel -- bind a List COMP to devices_table in your own project to build one.'
          - name: Beacondiscovery
            style: Toggle
            label: Broker Auto-Discovery (Beacon)
            help: 'Enable UDP broker self-correction: every 30s, probes whatever Brokerhost is currently set to on port 8899 with ''GAIA_DISCOVER''; if it answers as service==''gaia-core'', Brokerhost is corrected to the reported mqtt_host. Does nothing if that host doesn''t answer (no blind network-wide discovery -- verify a gaia_beacon responder exists on this deployment''s Gaia Core before enabling). Off by default so a deliberately-set Brokerhost is never silently overwritten.'
            value: true
          Mocap:
          - name: Opsdevice
            style: Str
            label: OPS Device ID
            startSection: true
            default: ops-silvermini2
            help: Device id of the Gaia OPS node whose mediapipe_node.py sends direct mocap OSC (/gaia/mocap/{Opsdevice}/pose|hand|face/{person}). Change to point this project at a different OPS node.
          - name: Mocapport
            style: Int
            label: Mocap OSC Port
            default: 7000
            help: UDP port oscin_mocap listens on for direct mocap OSC. Change this if running MULTIPLE gaia_client instances in the same project (e.g. one per rig) with Direct Mocap Ingest enabled on more than one -- two instances cannot both bind the same port. Leave at 7000 for a single instance.
          Status:
          - name: Identitystatus
            style: Str
            label: Identity Status
            default: ok
            readOnly: true
            help: 'Live check of Deviceid/Family -- ''ok'' when both are set, otherwise lists which are MISSING and the component tile turns red in the network editor. Never silently inherited from a clone: check this after copying/instancing gaia_client and set both explicitly before the copy goes live. GAIA_INTERFACE.md section 1/1b.'
          - name: Connectionstatus
            style: Str
            label: Connection Status
            startSection: true
            default: not connected
            readOnly: true
            help: Live MQTT connection state of the ingest client (mqtt_ingest), updated by mqtt_ingest_callbacks.
            value: connected
          - name: Lastmessage
            style: Str
            label: Last Message
            readOnly: true
            help: Topic and local time of the most recently received Gaia MQTT message.
            value: gaia/brain/state @ 16:31:23
          - name: Deviceagentstatus
            style: Str
            label: Device Agent Status
            default: not connected
            readOnly: true
            help: Live MQTT connection state of the device-agent client (mqtt_device), updated by mqtt_device_callbacks. Separate from Connectionstatus above.
            value: connected
          - name: Beaconstatus
            style: Str
            label: Beacon Status
            default: not probed
            readOnly: true
            help: Outcome of the last broker auto-discovery probe (only active when Beacon Discovery is enabled).
            value: 'auto: 192.168.1.142 (beacon @ core-node-0, 18:30:56)'
        position: [0, -1225]
        size: [160, 130]
        color: [0.67, 0.67, 0.67]
        children:
        - name: lag_soul
          type: lagCHOP
          parameters:
            lag1: 1.5
            lag2: 1.5
          position: [1200, 700]
          inputs:
          - script_soul
        - name: out_soul
          type: nullCHOP
          position: [1600, 700]
          color: [0.67, 0.67, 0.67]
          inputs:
          - lag_soul
        - name: annotate1
          type: annotateCOMP
          sequences:
            ext:
            - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
              promote: true
          custom_pars:
            Text:
              $t: text
              Titletext: Gaia MQTT Ingest -- Canvas / Brain State / Dream
              Bodytext: 'Subscribes gaia/td/canvas, gaia/brain/state, gaia/brain/dream and caches the raw JSON per topic. Derived Script CHOP/DAT outputs: soul mood (out_soul), top-20 lexicon words + rotating current word, latest LLM thought. Gated by Services > Canvas Ingest (logic-level gate -- the mqttclientDAT connection itself always stays up).'
            Settings:
              $t: settings_2
              Mode: annotate
              Backcolorr: [0.325, 0.5, 0.3]
            OP Viewer:
              $t: op_viewer
              Opvieweroversize: natural
            About:
              $t: about
          position: [-70, -290]
          size: [1870, 1250]
          color: [0.45, 0.45, 0.45]
          palette_clone: true
        - name: annotate2
          type: annotateCOMP
          sequences:
            ext:
            - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
              promote: true
          custom_pars:
            Text:
              $t: text
              Titletext: Direct Mocap Ingest (OSC)
              Bodytext: Receives face/hand/pose/meta landmarks via OSC (port = Mocapport, default 7000) from a Gaia OPS node's mediapipe_node.py, scoped to /gaia/mocap/{Opsdevice}/*. Bounded, deterministic-slice extraction per channel family (unstable/unbounded raw addressing, no automatic expiry). Gated by Services > Direct Mocap Ingest, which binds oscin_mocap's own Active parameter directly (safe -- this is a CHOP, not a mqttclientDAT). Running 2+ gaia_client instances in one project (e.g. one per rig)? Give each a distinct Mocapport if more than one has mocap ingest enabled.
            Settings:
              $t: settings_2
              Mode: annotate
              Backcolorr: [0.3, 0.45, 0.55]
            OP Viewer:
              $t: op_viewer
              Opvieweroversize: natural
            About:
              $t: about
          position: [-70, -2390]
          size: [1070, 1650]
          color: [0.45, 0.45, 0.45]
          palette_clone: true
        - name: annotate3
          type: annotateCOMP
          sequences:
            ext:
            - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
              promote: true
          custom_pars:
            Text:
              $t: text
              Titletext: Device Registration (this instance as a controllable device)
              Bodytext: 'Publishes gaia/device/{id}/status heartbeat + gaia/devices/{id}/announce+profile, and accepts remote enable/disable/restart/set commands. Register real controls per-project via gaia_device_agent.module.register_service()/register_param() -- see its docstring. Gated by Services > Device Status (logic-level -- connection always stays up). WARNING: device_id defaults to td-{hostname}; do not run two Gaia device agents with the same device_id in the same project/network at once (they will fight over the same MQTT topic). reregister_watch fires the Services > Re-register pulse into gaia_device_agent.reregister() (GAIA_INTERFACE.md section 2) -- retries whatever project registrar was set via register_project_registrar() without restarting TD.'
            Settings:
              $t: settings_2
              Mode: annotate
              Backcolorr: [0.55, 0.45, 0.3]
            OP Viewer:
              $t: op_viewer
              Opvieweroversize: natural
            About:
              $t: about
          position: [-70, -3390]
          size: [1470, 450]
          color: [0.45, 0.45, 0.45]
          palette_clone: true
        - name: annotate4
          type: annotateCOMP
          sequences:
            ext:
            - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
              promote: true
          custom_pars:
            Text:
              $t: text
              Titletext: Device Fleet Control + Broker Auto-Discovery
              Bodytext: 'Fleet control: subscribes gaia/device/+/status for ALL Gaia devices, maintains devices_table, exposes gaia_fleet_control.send_command(device_id, service, action). Gated by Services > Device Fleet Control. Beacon discovery: probes UDP 8899 every 30s to self-correct Brokerhost if it drifts; gated by Services > Broker Auto-Discovery (off by default). No bundled UI -- bind a List COMP to devices_table per-project.'
            Settings:
              $t: settings_2
              Mode: annotate
              Backcolorr: [0.5, 0.35, 0.5]
            OP Viewer:
              $t: op_viewer
              Opvieweroversize: natural
            About:
              $t: about
          position: [-70, -4890]
          size: [1070, 950]
          color: [0.45, 0.45, 0.45]
          palette_clone: true
        - name: annotate5
          type: annotateCOMP
          sequences:
            ext:
            - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
              promote: true
          custom_pars:
            Text:
              $t: text
              Titletext: Portable Export
              Bodytext: 'pre_release hook (Embody ExportPortableTox): blanks instance/project identity pars (Deviceid, Family, Stanza, opshortcut, Name) on the staged export copy only -- never touches the live component.'
            Settings:
              $t: settings_2
              Mode: annotate
              Backcolorr:
              - '=me.color[0] # node color [r]'
              - =me.color[1]
              - '=me.color[2] '
            OP Viewer:
              $t: op_viewer
              Opvieweroversize: natural
            About:
              $t: about
          position: [-70, -5620]
          size: [270, 330]
          color: [0.45, 0.45, 0.45]
          palette_clone: true
        - name: chop_face
          type: scriptCHOP
          parameters:
            callbacks: chop_face_callbacks
          position: [800, -1000]
