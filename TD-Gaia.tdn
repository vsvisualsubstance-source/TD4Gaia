      - name: tagger
        type: containerCOMP
        parameters:
          w: 180
          h: =28 * (me.fetch('visible_count', op('./tags').numRows) + (2 if (op('./btn_copy_tdxn') and op('./btn_copy_tdxn').par.display.eval()) else 0)) + 2
          display: false
          bgcolorr: =parent.Embody.par.Listrowcolorr
          bgcolorg: =parent.Embody.par.Listrowcolorg
          bgcolorb: =parent.Embody.par.Listrowcolorb
          bgalpha: 1
          borderar: 0.26426
          borderag: 0.298469
          borderab: 0.362
          align: verttb
          parentshortcut: menu
          reloadbuiltin: false
        position: [900, 225]
        size: [108, 155]
        color: [0.325, 0.8, 0.3]
        tags:
        - tox
        children:
        - name: tags
          type: nullDAT
          flags:
          - viewer
          position: [-400, 0]
          size: [130, 90]
          inputs:
          - switch_family
          dat_read_only: true
        - name: header
          type: containerCOMP
          parameters:
            h: 28
            hmode: fill
            bgcolorr: =parent.Embody.par.Listheadercolorr
            bgcolorg: =parent.Embody.par.Listheadercolorg
            bgcolorb: =parent.Embody.par.Listheadercolorb
            bgalpha: =parent.Embody.par.Listheadercolora
            borderover: false
            reloadbuiltin: false
          flags:
          - viewer
          position: [0, 275]
          size: [160, 76]
          color: [0.325, 0.8, 0.3]
          tags:
          - tox
          children:
          - name: text1
            type: textCOMP
            parameters:
              text: Actions
              callbacks: text1_callbacks
              legacyfontselection: true
              fontsize: 12
              fontcolorr: =parent.Embody.par.Textcolorr
              fontcolorg: =parent.Embody.par.Textcolorg
              fontcolorb: =parent.Embody.par.Textcolorb
              fontalpha: =parent.Embody.par.Textcolora
              h: 30
              hmode: fill
              bgcolorr: =parent.Embody.par.Backgroundcolorr
              bgcolorg: =parent.Embody.par.Backgroundcolorg
              bgcolorb: =parent.Embody.par.Backgroundcolorb
              bgalpha: =parent.Embody.par.Backgroundcolora
              borderover: false
              reloadbuiltin: false
            flags:
            - viewer
            position: [-200, 0]
            size: [160, 129]
            color: [0.325, 0.8, 0.3]
            tags:
            - tox
          - name: button_close
            type: buttonCOMP
            parameters:
              label: ×
              buttontype: momentary
              scaletofit: onlyshrink
              fontsize: 12
              colorr: =parent.Embody.par.Textcolorr
              colorg: =parent.Embody.par.Textcolorg
              colorb: =parent.Embody.par.Textcolorb
              w: 28
              h: 28
              layer: 1
              leftanchor: 1
              horigin: 1
              bgcolorr: =parent.Embody.par.Backgroundcolorr
              bgcolorg: =parent.Embody.par.Backgroundcolorg
              bgcolorb: =parent.Embody.par.Backgroundcolorb
              bgalpha: =parent.Embody.par.Backgroundcolora
              topsmoothness: mipmap
              reloadbuiltin: false
              relpath: inherit
            position: [50, 0]
            size: [160, 134]
            children:
            - name: out1
              type: outCHOP
              parameters:
                label: =me.name
              position: [275, 175]
              inputs:
              - par1
            - name: par1
              type: parameterCHOP
              position: [65, 175]
            - name: text
              type: textCOMP
              parameters:
                text: =parent().par.label
                type: multiline
                legacyfontselection: true
                scaletofit: onlyshrink
                fontsize: 12
                fontcolorr: =[c/.5 for c in [.1, .3]][parent().panel.state] * parent().par.colorr + .5
                fontcolorg: =[c/.5 for c in [.1, .3]][parent().panel.state] * parent().par.colorg + .5
                fontcolorb: =[c/.5 for c in [.1, .3]][parent().panel.state] * parent().par.colorb + .5
                textpaddingl: 3
                textpaddingr: 3
                textpaddingb: 3
                textpaddingt: 3
                hmode: fill
                vmode: fill
                clickthrough: true
                bgcolorr: =parent.Embody.par.Listheadercolorr
                bgcolorg: =parent.Embody.par.Listheadercolorg
                bgcolorb: =parent.Embody.par.Listheadercolorb
                bgalpha: 1
                borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorr + .2
                borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorg + .2
                borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorb + .2
                borderaalpha: 0
                reloadbuiltin: false
              flags:
              - viewer
              position: [74, 26]
              size: [113, 108]
            - name: parexec1
              type: parameterexecuteDAT
              parameters:
                op: ..
                pars: value0
                onpulse: false
                defaultreadencoding: cp1252
              flags:
              - viewer
              position: [66, -83]
              size: [128, 66]
              dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select :\n\t\tparent().panel.state = par.eval()\n\t\t\n\tif par:\n\t\tparent.Embody.ext.Embody.tagExiter()\n\t\t\n\treturn"
              dat_content_format: text
            - name: panelexec1
              type: panelexecuteDAT
              parameters:
                panels: =parent()
                panelvalue: state
                offtoon: false
                valuechange: true
                defaultreadencoding: cp1252
              flags:
              - viewer
              position: [247, -81]
              size: [126, 62]
              dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\t\t\n\treturn"
              dat_content_format: text
          - name: text1_callbacks
            type: textDAT
            parameters:
              language: python
            flags:
            - viewer
            - -showDocked
            position: [-200, -160]
            size: [160, 130]
            color: [0.9, 0.3, 0.4]
            tags:
            - py
            dock: text1
        - name: button0
          type: buttonCOMP
          parameters:
            label: =op('tags')[me.digits, 'label']
            buttontype: momentary
            scaletofit: onlyshrink
            fontsize: 12
            colorr: =parent.Embody.par.Taggingmenucolorr
            colorg: =parent.Embody.par.Taggingmenucolorg
            colorb: =parent.Embody.par.Taggingmenucolorb
            h: 28
            hmode: fill
            alignorder: 1
            display: false
            topsmoothness: mipmap
            reloadbuiltin: false
            relpath: inherit
          position: [-225, 175]
          size: [160, 76]
          storage:
            _tdn_palette_handling: blackbox
          children:
          - name: out1
            type: outCHOP
            parameters:
              label: =me.name
            position: [275, 175]
            inputs:
            - par1
          - name: par1
            type: parameterCHOP
            position: [65, 175]
          - name: text
            type: textCOMP
            parameters:
              text: =parent().par.label
              type: multiline
              legacyfontselection: true
              scaletofit: onlyshrink
              fontsize: 12
              fontcolorr: =parent.Embody.par.Textcolorr
              fontcolorg: =parent.Embody.par.Textcolorg
              fontcolorb: =parent.Embody.par.Textcolorb
              fontalpha: =parent.Embody.par.Textcolora
              textpaddingl: 12
              textpaddingr: 3
              textpaddingb: 3
              textpaddingt: 3
              alignx: left
              hmode: fill
              vmode: fill
              clickthrough: true
              bgcolorr: =parent.Embody.par.Listrowselectcolorr if parent().panel.rollover else parent.Embody.par.Listrowcolorr
              bgcolorg: =parent.Embody.par.Listrowselectcolorg if parent().panel.rollover else parent.Embody.par.Listrowcolorg
              bgcolorb: =parent.Embody.par.Listrowselectcolorb if parent().panel.rollover else parent.Embody.par.Listrowcolorb
              bgalpha: 1
              borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorr + .2
              borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorg + .2
              borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().panel.state + 2*parent().panel.rollover] * parent().par.colorb + .2
              borderover: false
              reloadbuiltin: false
            flags:
            - viewer
            position: [74, 26]
            size: [113, 64]
          - name: parexec1
            type: parameterexecuteDAT
            parameters:
              op: ..
              pars: value0
              onpulse: false
              defaultreadencoding: cp1252
            flags:
            - viewer
            position: [66, -83]
            size: [128, 66]
            dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select:\n\t\tparent().panel.state = par.eval()\n\n\tif par:\n\t\toper = parent.Embody.ext.Embody.rolloverOp\n\t\ttag = op('../tags')[parent().digits, 'value'].val\n\n\t\tif parent.Embody.ext.Embody._tagger_mode == 'manage':\n\t\t\tlabel = parent().par.label.eval()\n\t\t\tif 'Remove' in label:\n\t\t\t\t# Close window first, then show confirmation dialog\n\t\t\t\tparent.Embody.ext.Embody.tagExiter()\n\t\t\t\trun(lambda o=oper, t=tag, l=label: parent.Embody.ext.Embody._dispatchTaggerButton(o, t, l),\n\t\t\t\t\tdelayFrames=2)\n\t\t\telse:\n\t\t\t\tparent.Embody.ext.Embody._dispatchTaggerButton(oper, tag, label)\n\t\t\t\tparent.Embody.ext.Embody.tagExiter()\n\t\telse:\n\t\t\t# Tag mode: toggle + immediate externalize if added\n\t\t\tparent.Embody.ext.Embody.tagSetter(oper, tag)\n\t\t\tif tag in oper.tags:\n\t\t\t\tparent.Embody.ext.Embody.externalizeImmediate(oper)\n\t\t\tparent.Embody.Refresh()\n\t\t\tparent.Embody.ext.Embody.tagExiter()\n\n\treturn\n"
            dat_content_format: text
          - name: panelexec1
            type: panelexecuteDAT
            parameters:
              panels: =parent()
              panelvalue: state
              offtoon: false
              valuechange: true
              defaultreadencoding: cp1252
            flags:
            - viewer
            position: [247, -81]
            size: [126, 62]
            dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\treturn"
            dat_content_format: text
