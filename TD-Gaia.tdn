        Mood Nudge:
        - name: Deltastress
          style: Float
          label: Delta (Stress)
          startSection: true
          default: 0.1
          min: -1.0
          clampMin: true
          clampMax: true
          normMin: -1.0
          help: Amount to add to Gaia's stress mood dimension (0-1 scale, clamped by Gaia) on the next SendStress pulse. Negative subtracts.
          value: 0
