          dock: glsl_point_glow
      - name: affinity_ctrl
        type: baseCOMP
        custom_pars:
          Affinity Wash:
          - name: Affinityenable
            style: Toggle
            startSection: true
            default: true
            help: Master enable for the per-person affinity/recognition glow. When off, the wash contributes nothing regardless of who is present.
          - name: Affinityamount
            style: Float
            default: 0.2
            clampMin: true
            normMax: 0.5
            help: Maximum strength of the affinity wash, scaled down further by the weighted-average affinity of whoever is currently present (a stranger barely tints the scene even at full amount).
            value: 0.041
          - name: Affinitylagtime
            style: Float
            default: 1.2
            max: 10.0
            clampMin: true
            normMax: 5.0
            help: Seconds of easing applied to the affinity wash's color and intensity, so recognizing or losing a person fades the glow in/out instead of snapping.
            value: 0.89
        position: [-25, -2350]
        size: [290, 322]
        color: [0.325, 0.8, 0.3]
      - name: cam_soggiorno
        type: videostreaminTOP
        parameters:
          url: http://192.168.1.240:8766/video
        flags:
        - bypass
        - viewer
        position: [3000, -1200]
      - name: canvas_bridge
        type: scriptCHOP
        parameters:
          callbacks: canvas_bridge_callbacks
        position: [1600, -1200]
        inputs:
        - canvas_bridge_clock
      - name: composite_out
        type: compositeTOP
        parameters:
          operand: add
        flags:
        - viewer
        position: [3875, -950]
        inputs:
        - transform3
        - moodwash_out
        - webBrowser
        - webrender1
        - transform2
        - transform1
        - webBrowser1
      - name: dream_render1
        type: renderTOP
        parameters:
          camera: dream_cam
          geometry: dream_fragment dream_geo
          lights: dream_light
          bgcolorr: 0.02
          bgcolorg: 0.02
          bgcolorb: 0.05
          bgcolora: 1
          resolutionw: 640
          resolutionh: 360
        position: [4375, -1275]
      - name: event_watcher
        type: scriptCHOP
        parameters:
          callbacks: event_watcher_callbacks
        position: [1600, -600]
        storage:
          dbg_bare: /project1/container1/Visuals/event_ctrl
          dbg_dot1: None
          dbg_dot2: None
          dbg_me: /project1/container1/Visuals/event_watcher_callbacks
          dbg_me_parent: /project1/container1/Visuals
          last_error: |
            Traceback (most recent call last):
              File "/project1/container1/Visuals/event_watcher_callbacks", line 3, in onCook
              File "/project1/container1/Visuals/event_watcher_callbacks", line 29, in _onCookImpl
            AttributeError: 'NoneType' object has no attribute 'par'
          prev_dreamnew: 0
          prev_levelup: 0
      - name: math_dmx_wash
        type: mathCHOP
        parameters:
          gain: =op('dmx_ctrl').par.Lightscale.eval()
          postoff: =((op('data_canvas/null_mood_rgb')['gaia/canvas/soul/mood_rgb/r']/255.0 + op('data_canvas/null_mood_rgb')['gaia/canvas/soul/mood_rgb/g']/255.0 + op('data_canvas/null_mood_rgb')['gaia/canvas/soul/mood_rgb/b']/255.0)/3.0) * op('dmx_ctrl').par.Washtodmxamount.eval() * 255.0
        position: [3920, 873]
        inputs:
        - select_lights_for_dmx
      - name: moodwash_ctrl
        type: baseCOMP
        custom_pars:
          Mood Wash:
          - name: Washamount
            style: Float
            label: Wash Amount
            startSection: true
            default: 0.15
            clampMin: true
            clampMax: true
            help: Blend strength of the ambient soul-mood color wash applied over the whole render before bloom. 0 = no wash, 1 = full strength.
            value: 0.116
          - name: Washmode
            style: Menu
            label: Wash Mode
            default: Add
            menuNames:
            - Add
            - Screen
            help: Compositing operand used to blend the mood wash onto the render. Add reads even in pure black regions; Screen is gentler on already-bright areas.
          - name: Washlagtime
            style: Float
            label: Wash Lag Time
            default: 1.5
            max: 10.0
            clampMin: true
            normMax: 5.0
            help: Seconds of smoothing applied to the mood color before it reaches the wash, so the scene's base color eases rather than snaps when Gaia's mood changes. Drives data_canvas/lag_mood_rgb's Lag parameters.
            value: 1.47
          - name: Kickamount
            style: Float
            label: Kick Amount
            default: 0.12
            clampMin: true
            normMax: 0.5
            help: Extra wash boost added when a live audio kick is detected in any room via Gaia canale 2 (gaia/canvas/rooms/*/audioKick, cross-rig -- e.g. ControllerV7/mixeraudio). 0 = no reaction to kicks, 1 = full-strength pulse on every kick.
            value: 0
        flags:
        - viewer
        position: [325, -2350]
        size: [216, 312]
        color: [0.325, 0.8, 0.3]
      - name: over_sediment
        type: compositeTOP
        parameters:
          operand: over
          outputresolution: custom
          resolutionw: 1280
          resolutionh: 720
          format: rgba8fixed
        flags:
        - viewer
        position: [1650, -225]
        inputs:
        - render1
        - level_sediment_out
      - name: render_asemic
        type: renderTOP
        parameters:
          camera: cam_asemic
          geometry: geo_asemic
        position: [2500, -1700]
      - name: sediment_ctrl
        type: baseCOMP
        custom_pars:
          Sediment:
          - name: Sedimentreset
            style: Pulse
            label: Reset
            startSection: true
            help: Clears the accumulated lexicon-ink feedback buffer back to black in a single frame.
          - name: Sedimentdecay
            style: Float
            label: Decay
            startSection: true
            default: 0.99
            min: 0.9
            clampMin: true
            clampMax: true
            normMin: 0.9
            help: Per-frame multiplier applied to the accumulated ink before adding this frame's fresh deposit. Must stay strictly below 1.0 so the buffer can never grow unbounded - lower values fade faster, closer to 1.0 lingers longer.
            value: 0.9158
          - name: Sedimentamount
            style: Float
            label: Amount
            default: 1
            max: 3.0
            clampMin: true
            normMax: 2.0
            help: Overall visibility multiplier for the ink layer in the final composite - a faint, slow-building background texture representing Gaia's recurring words/personality, not a foreground element.
            value: 0.85
        position: [0, -2750]
        size: [339, 298]
        color: [0.325, 0.8, 0.3]
