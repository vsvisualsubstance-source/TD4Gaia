      - name: soul_geo
        type: geometryCOMP
        parameters:
          tz: -2
          material: ./pointsprite_soul
        flags:
        - display
        - render
        position: [0, -225]
        size: [160, 130]
        children:
        - name: noise1
          type: noisePOP
          parameters:
            period: =1 + 6*(op('../data/null_soul')['gaia/soul/energy']/100)
            gain: =0.3 + 0.5*(op('../data/null_soul')['gaia/soul/stress']/100)
            amp0: '=tdu.tryExcept(lambda: 0.05 + 0.35*(op(''../data/null_soul'')[''gaia/soul/curiosity'']/100) + 0.25*op(''../data/null_mediapipe_agg'')[''global_mouth_max''], 0.2)'
            tz: =absTime.seconds*(0.05+0.4*(op('../data/null_soul')['gaia/soul/energy']/100))
          flags:
          - viewer
          position: [400, 0]
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
          inputs:
          - sphere1
        - name: points1
          type: primitivePOP
          parameters:
            keep: true
            method: set
            setprimtype: points
          custom_pars:
            Points:
              $t: points
          flags:
          - display
          - render
          - viewer
          position: [1600, 0]
          inputs:
          - glsl_soulfx
        - name: sphere1
          type: spherePOP
          parameters:
            cols: 40
            rows: 40
        - name: transform1
          type: transformPOP
          parameters:
            ry: =absTime.seconds*(4+20*(op('../data/null_soul')['gaia/soul/social']/100))
            scale: =0.6 + 0.8*(op('../data/null_soul')['gaia/soul/lifeIndex']/100)
          position: [800, 75]
          inputs:
          - noise1
        - name: glsl_soulfx
          type: glslPOP
          parameters:
            computedat: glsl_soulfx_compute
          sequences:
            attr:
            - name: color
            - name: pointscale
            vec:
            - name: uStress
              valuex: =op('../data/null_soul')['gaia/soul/stress']/100
            - name: uCalm
              valuex: =op('../data/null_soul')['gaia/soul/calm']/100
            - name: uEnergy
              valuex: =op('../data/null_soul')['gaia/soul/energy']/100
            - name: uPeoplePresent
              valuex: =min(1.0, op('../data/null_people')['gaia/stats/totalPeopleCount'] / 4.0)
            - name: uSmile
              valuex: '=tdu.tryExcept(lambda: min(1.0, op(''../data/null_mediapipe_agg'')[''global_smile_max''] / 100.0), 0.15)'
            - name: uEyesOpen
              valuex: '=tdu.tryExcept(lambda: op(''../data/null_mediapipe_agg'')[''global_eyes_min''], 0.9)'
            - name: uTime
              valuex: =absTime.seconds
            - name: uLifeIndex
              valuex: '=tdu.tryExcept(lambda: op(''/project1/container1/Visuals/canvas_bridge'')[''gaia/canvas/soul/lifeIndex''] / 100.0, 0.5)'
            - name: uActiveLights
              valuex: '=tdu.tryExcept(lambda: min(1.0, op(''/project1/container1/oscin1'')[''gaia/metrics/activeLights''] / 5.0), 0.3)'
            - name: uActivePeople
              valuex: '=tdu.tryExcept(lambda: min(1.0, op(''/project1/container1/oscin1'')[''gaia/metrics/activePeople''] / 4.0), 0.25)'
            - name: uAverageLight
              valuex: '=tdu.tryExcept(lambda: min(1.0, op(''/project1/container1/oscin1'')[''gaia/metrics/averageLight''] / 100.0), 0.4)'
            sampler:
            - name: roomTex
              top: /project1/container1/Visuals/data/chopto_room_env
              filter: nearest
            - name: lightTex
              top: /project1/container1/Visuals/data/chopto_room_light
              filter: nearest
          position: [1200, 75]
          inputs:
          - transform1
        - name: envoy_bot_body
          type: annotateCOMP
          sequences:
            ext:
            - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
              promote: true
          custom_pars:
            Text:
              $t: text
              Titletext: ''
              Titleheight: 0
            Settings:
              $t: settings_2
              Mode: networkbox
              Backcolorr: [1, 1, 0.05]
            OP Viewer:
              $t: op_viewer
              Opvieweroversize: natural
            About:
              $t: about
          position: [1250, 189]
          size: [30, 34]
          color: [0.45, 0.45, 0.45]
          palette_clone: true
        - name: envoy_bot_head
          type: annotateCOMP
          sequences:
            ext:
            - object: op.TDAnnotate.mod.AnnotateExt.AnnotateExt(me)
              promote: true
          custom_pars:
            Text:
              $t: text
              Titletext: ''
              Titleheight: 0
            Settings:
              $t: settings_2
              Mode: networkbox
              Backcolorr: [1, 1, 0.05]
            OP Viewer:
              $t: op_viewer
              Opvieweroversize: natural
            About:
              $t: about
          position: [1248, 224]
          size: [34, 26]
          color: [0.45, 0.45, 0.45]
          palette_clone: true
        - name: envoy_bot_arm_l
