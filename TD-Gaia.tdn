            - name: uMoodG
              valuex: '=tdu.tryExcept(lambda: op(''../data_canvas/null_mood_rgb'')[''gaia/canvas/soul/mood_rgb/g''] / 255, 0.5)'
            - name: uMoodB
              valuex: '=tdu.tryExcept(lambda: op(''../data_canvas/null_mood_rgb'')[''gaia/canvas/soul/mood_rgb/b''] / 255, 0.55)'
            - name: uTime
